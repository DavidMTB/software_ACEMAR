<UserControl x:Class="software_ACEMAR.Views.DashboardGeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:software_ACEMAR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1100"
             Background="#F4F6F0">

    <UserControl.Resources>
        <!-- Estilo de Botón Atajo Directo -->
        <Style x:Key="ShortcutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#354318" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#4A5D23" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A5D23" />
                                <Setter Property="BorderBrush" Value="#8FA668" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryShortcutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EAF0E1" />
            <Setter Property="Foreground" Value="#1E2514" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#B5C6A0" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DCE8CF" />
                                <Setter Property="BorderBrush" Value="#4A5D23" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18">

            <!-- ================================================================= -->
            <!-- 1. CABECERA & BOTÓN DE ACTUALIZACIÓN EN TIEMPO REAL              -->
            <!-- ================================================================= -->
            <Border Background="#1D2611" CornerRadius="10" Padding="16,14" Margin="0,0,0,16"
                    ToolTip="Panel Principal de Control: Visualice el estado general de su ferretería en tiempo real.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊 PANEL DE CONTROL GENERAL ACEMAR" 
                                       FontSize="17" FontWeight="Black" Foreground="#FFFFFF" />
                            <Border Background="#4A5D23" CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                                    ToolTip="Las métricas se recalculan en tiempo real con cada venta o movimiento.">
                                <TextBlock Text="EN VIVO" FontSize="10" FontWeight="Bold" Foreground="#BCE08A" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Resumen visual de ventas, fiados por cobrar, alertas de inventario y atajos rápidos a todas las ventanas." 
                                   FontSize="11" Foreground="#BCE08A" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding ActualizarDashboardCommand}"
                            Style="{StaticResource ShortcutButtonStyle}" VerticalAlignment="Center"
                            ToolTip="Haga clic aquí para volver a cargar y refrescar todos los números del panel.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " FontSize="13" />
                            <TextBlock Text="Actualizar Métricas" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ================================================================= -->
            <!-- 2. KPI TARJETAS PRINCIPALES (CON BOTONES ATAJOS)                  -->
            <!-- ================================================================= -->
            <UniformGrid Columns="4" Margin="0,0,0,16">

                <!-- KPI 1: Ventas del Día -->
                <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCDEC8" BorderThickness="1" Margin="0,0,8,0" Padding="14"
                        ToolTip="Monto total en Soles cobrado por ventas realizadas el día de hoy.">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VENTAS COBRADAS HOY" FontSize="10" FontWeight="ExtraBold" Foreground="#4A5D23" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="🛒" FontSize="16" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalVentasHoy, StringFormat='S/{0:N2}'}" 
                                   FontSize="20" FontWeight="Black" Foreground="#1E2514" Margin="0,6,0,8"
                                   ToolTip="Suma acumulada de todas las ventas cobradas hoy." />
                        <Button Grid.Row="2" Command="{Binding NavegarACommand}" CommandParameter="POS"
                                Style="{StaticResource SecondaryShortcutButtonStyle}" Content="🛒 Abrir Punto de Venta" HorizontalAlignment="Stretch"
                                ToolTip="Ir a la pantalla del Punto de Venta para atender a un cliente." />
                    </Grid>
                </Border>

                <!-- KPI 2: Créditos & Fiados Pendientes -->
                <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCDEC8" BorderThickness="1" Margin="4,0,4,0" Padding="14"
                        ToolTip="Monto total acumulado que los clientes deben a la ferretería en fiados/créditos.">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DINERO EN FIADOS (POR COBRAR)" FontSize="10" FontWeight="ExtraBold" Foreground="#E65100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="💳" FontSize="16" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding TotalDeudaCreditos, StringFormat='S/{0:N2}'}" 
                                   FontSize="20" FontWeight="Black" Foreground="#D32F2F" Margin="0,6,0,8"
                                   ToolTip="Suma total de deudas vigentes de clientes." />
                        <Button Grid.Row="2" Command="{Binding NavegarACommand}" CommandParameter="Creditos"
                                Style="{StaticResource SecondaryShortcutButtonStyle}" Content="💳 Ver Clientes Fiados" HorizontalAlignment="Stretch"
                                ToolTip="Ir a la ventana de créditos para registrar abonos o consultar cuentas por cobrar." />
                    </Grid>
                </Border>

                <!-- KPI 3: Alerta de Stock Bajo & Lotes -->
                <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCDEC8" BorderThickness="1" Margin="4,0,4,0" Padding="14"
                        ToolTip="Resumen de alertas: productos que se están agotando y lotes próximos a vencer.">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ALERTAS DE ALMACÉN &amp; STOCK" FontSize="10" FontWeight="ExtraBold" Foreground="#C62828" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="📦" FontSize="16" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,8">
                            <TextBlock Text="{Binding TotalProductosBajoStock}" FontSize="20" FontWeight="Black" Foreground="#C62828" ToolTip="Productos por debajo del límite mínimo" />
                            <TextBlock Text=" bajo mín. / " FontSize="12" VerticalAlignment="Bottom" Foreground="#666666" Margin="2,0,2,2" />
                            <TextBlock Text="{Binding TotalLotesPorVencer}" FontSize="20" FontWeight="Black" Foreground="#E65100" ToolTip="Lotes próximos a agotarse" />
                            <TextBlock Text=" lotes bajos" FontSize="12" VerticalAlignment="Bottom" Foreground="#666666" Margin="2,0,0,2" />
                        </StackPanel>
                        <Button Grid.Row="2" Command="{Binding NavegarACommand}" CommandParameter="Inventario"
                                Style="{StaticResource SecondaryShortcutButtonStyle}" Content="📦 Ver Almacén &amp; Lotes" HorizontalAlignment="Stretch"
                                ToolTip="Ir a la lista de inventario para ver existencias y reponer mercadería." />
                    </Grid>
                </Border>

                <!-- KPI 4: Arqueo de Caja Chica -->
                <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCDEC8" BorderThickness="1" Margin="8,0,0,0" Padding="14"
                        ToolTip="Dinero físico total que debe haber actualmente en la caja de la ferretería.">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="EFECTIVO EN CAJA CHICA" FontSize="10" FontWeight="ExtraBold" Foreground="#2E7D32" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="💵" FontSize="16" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding SaldoCajaChica, StringFormat='S/{0:N2}'}" 
                                   FontSize="20" FontWeight="Black" Foreground="#2E7D32" Margin="0,6,0,8"
                                   ToolTip="Efectivo de apertura + ventas en efectivo + abonos - egresos." />
                        <Button Grid.Row="2" Command="{Binding NavegarACommand}" CommandParameter="Caja"
                                Style="{StaticResource SecondaryShortcutButtonStyle}" Content="💵 Arqueo &amp; Cierre Caja" HorizontalAlignment="Stretch"
                                ToolTip="Ir a la pantalla de arqueo para cuadrar o realizar el cierre de caja." />
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ================================================================= -->
            <!-- 3. FILA 1 DE GRÁFICOS: DONAS / DONUT & BARRAS VERTICALES          -->
            <!-- ================================================================= -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- GRÁFICO 1: DONUT / DISTRIBUCIÓN DE MEDIOS DE PAGO -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCDEC8" BorderThickness="1" Padding="16"
                        ToolTip="Muestra la proporción de dinero cobrado en Efectivo, Yape/Plin/Digital y Fiado.">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🍩 " FontSize="16" />
                                <TextBlock Text="Formas de Pago Utilizadas (Gráfico Circular)" FontSize="13" FontWeight="Bold" Foreground="#1E2514" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding NavegarACommand}" CommandParameter="Auditoria"
                                    Style="{StaticResource SecondaryShortcutButtonStyle}" Content="🛡️ Auditoría"
                                    ToolTip="Ir a la auditoría de ventas procesadas." />
                        </Grid>

                        <!-- Contenido Gráfico Dona Vectorial -->
                        <Grid Grid.Row="1" Margin="0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Dona Visual de Anillos Concéntricos -->
                            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  ToolTip="Visualización circular de porcentajes por tipo de cobro.">
                                <Ellipse Width="120" Height="120" Stroke="#E0E0E0" StrokeThickness="16" />
                                <!-- Anillo Verde (Efectivo) -->
                                <Ellipse Width="120" Height="120" Stroke="#2E7D32" StrokeThickness="16" 
                                         StrokeDashArray="70,30" StrokeDashOffset="0" />
                                <!-- Anillo Azul (Digital) -->
                                <Ellipse Width="120" Height="120" Stroke="#0288D1" StrokeThickness="16" 
                                         StrokeDashArray="30,70" StrokeDashOffset="-70" />
                                <!-- Anillo Naranja (Crédito) -->
                                <Ellipse Width="120" Height="120" Stroke="#E65100" StrokeThickness="16" 
                                         StrokeDashArray="15,85" StrokeDashOffset="-100" />

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL MES" FontSize="9" FontWeight="Bold" Foreground="#777777" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalVentasMes, StringFormat='S/{0:N0}'}" 
                                               FontSize="13" FontWeight="Black" Foreground="#1E2514" HorizontalAlignment="Center"
                                               ToolTip="Ventas acumuladas en el mes presente." />
                                </StackPanel>
                            </Grid>

                            <!-- Leyenda de Distribución -->
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding MediosPagoDistribucion}" VerticalAlignment="Center" Margin="10,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,4" Padding="8,4" Background="#F8F9F5" CornerRadius="6" BorderBrush="#E5E8DD" BorderThickness="1"
                                                ToolTip="{Binding Monto, StringFormat='Total cobrado: S/{0:N2}'}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Icono}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nombre}" FontSize="11" FontWeight="Bold" Foreground="#1E2514" />
                                                    <TextBlock Text="{Binding Monto, StringFormat='S/{0:N2}'}" FontSize="10" Foreground="#555555" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{Binding ColorHex}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Porcentaje, StringFormat='{}{0}%'}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="📊 Muestra el porcentaje de ingresos según el método de pago elegido por los clientes." 
                                   FontSize="10" Foreground="#666666" HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- GRÁFICO 2: BARRAS VERTICALES / VENTAS 7 DÍAS -->
                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCDEC8" BorderThickness="1" Padding="16"
                        ToolTip="Muestra la comparación de ventas diarias durante los últimos 7 días.">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📊 " FontSize="16" />
                                <TextBlock Text="Ventas de la Última Semana (Día por Día)" FontSize="13" FontWeight="Bold" Foreground="#1E2514" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding NavegarACommand}" CommandParameter="POS"
                                    Style="{StaticResource SecondaryShortcutButtonStyle}" Content="🛒 Nueva Venta"
                                    ToolTip="Abrir el punto de venta." />
                        </Grid>

                        <!-- Barras Verticales -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding VentasUltimos7Dias}" Margin="0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" VerticalAlignment="Bottom" Height="140" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Bottom" Margin="4,0" ToolTip="{Binding Monto, StringFormat='Total vendido este día: S/{0:N2}'}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- Valor Monto sobre la barra -->
                                        <TextBlock Grid.Row="0" Text="{Binding MontoFormateado}" FontSize="9" FontWeight="Bold" 
                                                   Foreground="#354318" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <!-- Barra Vertical -->
                                        <Border Grid.Row="1" Height="{Binding AlturaBarra}" Width="24" CornerRadius="4,4,0,0" 
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#4A5D23" Offset="0.0" />
                                                    <GradientStop Color="#1D2611" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <!-- Etiqueta Día -->
                                        <TextBlock Grid.Row="2" Text="{Binding Dia}" FontSize="9" FontWeight="ExtraBold" 
                                                   Foreground="#666666" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Row="2" Text="📈 Comparación de montos vendidos día a día en los últimos 7 días." 
                                   FontSize="10" Foreground="#666666" HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ================================================================= -->
            <!-- 4. FILA 2 DE GRÁFICOS: BARRAS HORIZONTALES & CERRUCHO DE PICOS     -->
            <!-- ================================================================= -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- GRÁFICO 3: BARRAS HORIZONTALES / TOP PRODUCTOS MÁS VENDIDOS -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCDEC8" BorderThickness="1" Padding="16"
                        ToolTip="Lista de los 5 productos más vendidos de la ferretería por total recaudado.">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏷️ " FontSize="16" />
                                <TextBlock Text="Productos Más Vendidos de la Ferretería" FontSize="13" FontWeight="Bold" Foreground="#1E2514" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding NavegarACommand}" CommandParameter="Catalogo"
                                    Style="{StaticResource SecondaryShortcutButtonStyle}" Content="🏷️ Ver Catálogo"
                                    ToolTip="Ver lista completa de productos y precios." />
                        </Grid>

                        <!-- Lista de Barras Horizontales -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopProductosMasVendidos}" Margin="0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5" ToolTip="{Binding MontoTotal, StringFormat='Venta acumulada: S/{0:N2}'}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Nombre}" FontSize="11" FontWeight="Bold" Foreground="#1E2514" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding CantidadVendida, StringFormat='{}{0:N0} '}" FontSize="10" FontWeight="Bold" Foreground="#4A5D23" />
                                                <TextBlock Text="{Binding Unidad}" FontSize="10" Foreground="#666666" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding MontoTotal, StringFormat='(S/{0:N2})'}" FontSize="10" FontWeight="Bold" Foreground="#1E2514" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Barra de Progreso Horizontal Gradiente -->
                                        <Border Height="10" Background="#EAECE4" CornerRadius="5" Margin="0,3,0,0">
                                            <ProgressBar Value="{Binding PorcentajeBarra}" Maximum="100" Height="10" Foreground="#4A5D23" Background="Transparent" BorderThickness="0" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Row="2" Text="🏆 Clasificación de productos con mayor número de ventas e ingresos." 
                                   FontSize="10" Foreground="#666666" HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- GRÁFICO 4: CERRUCHO / PICOS Y VALLES DE TENDENCIA DE DEMANDA -->
                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCDEC8" BorderThickness="1" Padding="16"
                        ToolTip="Línea de tendencia con picos (altas ventas) y valles (reposición).">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📈 " FontSize="16" />
                                <TextBlock Text="Movimientos y Picos de Demanda (Tendencia)" FontSize="13" FontWeight="Bold" Foreground="#1E2514" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding NavegarACommand}" CommandParameter="Proformas"
                                    Style="{StaticResource SecondaryShortcutButtonStyle}" Content="📋 Proformas"
                                    ToolTip="Ver o emitir proformas y cotizaciones." />
                        </Grid>

                        <!-- Canvas Gráfico de Cerrucho (Vector Linear Graphic) -->
                        <Grid Grid.Row="1" Margin="0,12" Height="140" ToolTip="Gráfico que representa la fluidez y variaciones de demanda en el tiempo.">
                            <!-- Fondo de Cuadrícula de Referencia -->
                            <UniformGrid Rows="4" Columns="1" Margin="0">
                                <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" />
                                <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" />
                                <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" />
                                <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" />
                            </UniformGrid>

                            <!-- Polygon Relleno Gradiente Verde Bajo la Línea -->
                            <Polygon Points="{Binding PuntosCerruchoRellenoString}" Opacity="0.35">
                                <Polygon.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4A5D23" Offset="0.0" />
                                        <GradientStop Color="#FFFFFF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Polygon.Fill>
                            </Polygon>

                            <!-- Polyline Línea Cerrucho de Picos -->
                            <Polyline Points="{Binding PuntosCerruchoLineaString}" Stroke="#2E3B15" StrokeThickness="2.5" StrokeLineJoin="Round" />

                            <!-- Indicadores de Picos y Valles -->
                            <Border Background="#1D2611" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,10,0"
                                    ToolTip="Momentos con mayor demanda de ventas.">
                                <TextBlock Text="🔺 PICOS DE VENTA" FontSize="9" FontWeight="Bold" Foreground="#BCE08A" />
                            </Border>

                            <Border Background="#E65100" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,10"
                                    ToolTip="Momentos donde se requiere reposición de stock.">
                                <TextBlock Text="🔻 VALLES REPOSICIÓN" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="2" Text="⚡ Muestra los momentos de mayor movimiento de ventas y reposición." 
                                   FontSize="10" Foreground="#666666" HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ================================================================= -->
            <!-- 5. SECCIÓN DE ATAJOS RÁPIDOS A TODAS LAS PESTAÑAS DEL SISTEMA     -->
            <!-- ================================================================= -->
            <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCDEC8" BorderThickness="1" Padding="16"
                    ToolTip="Accesos directos con un solo clic a todas las secciones del sistema.">
                <StackPanel>
                    <TextBlock Text="🚀 ATAJOS RÁPIDOS A TODAS LAS SECCIONES" FontSize="13" FontWeight="Black" Foreground="#1E2514" Margin="0,0,0,12" />

                    <UniformGrid Columns="3" Margin="0">
                        <!-- Atajo 1: POS -->
                        <Button Command="{Binding NavegarACommand}" CommandParameter="POS"
                                Style="{StaticResource SecondaryShortcutButtonStyle}" Margin="4" Padding="12,10"
                                ToolTip="Abrir la pantalla de cobro y ventas del Punto de Venta.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🛒 " FontSize="14" />
                                <TextBlock Text="Punto de Venta (POS)" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <!-- Atajo 2: Inventario -->
                        <Button Command="{Binding NavegarACommand}" CommandParameter="Inventario"
                                Style="{StaticResource SecondaryShortcutButtonStyle}" Margin="4" Padding="12,10"
                                ToolTip="Ver existencias, stock mínimo y valorización de inventario.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📦 " FontSize="14" />
                                <TextBlock Text="Inventario &amp; Almacén" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <!-- Atajo 3: Catálogo -->
                        <Button Command="{Binding NavegarACommand}" CommandParameter="Catalogo"
                                Style="{StaticResource SecondaryShortcutButtonStyle}" Margin="4" Padding="12,10"
                                ToolTip="Administrar la lista de productos y cambiar precios.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🏷️ " FontSize="14" />
                                <TextBlock Text="Catálogo &amp; Precios" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <!-- Atajo 4: Créditos -->
                        <Button Command="{Binding NavegarACommand}" CommandParameter="Creditos"
                                Style="{StaticResource SecondaryShortcutButtonStyle}" Margin="4" Padding="12,10"
                                ToolTip="Ver clientes fiados, registrar abonos y consultar deudas.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💳 " FontSize="14" />
                                <TextBlock Text="Créditos &amp; Fiados" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <!-- Atajo 5: Proformas -->
                        <Button Command="{Binding NavegarACommand}" CommandParameter="Proformas"
                                Style="{StaticResource SecondaryShortcutButtonStyle}" Margin="4" Padding="12,10"
                                ToolTip="Crear cotizaciones y proformas para clientes.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📋 " FontSize="14" />
                                <TextBlock Text="Proformas &amp; Cotizaciones" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <!-- Atajo 6: Arqueo Caja -->
                        <Button Command="{Binding NavegarACommand}" CommandParameter="Caja"
                                Style="{StaticResource SecondaryShortcutButtonStyle}" Margin="4" Padding="12,10"
                                ToolTip="Realizar arqueos, cuadres y cierre de caja diario.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💵 " FontSize="14" />
                                <TextBlock Text="Arqueo de Caja" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <!-- Atajo 7: Lotes -->
                        <Button Command="{Binding NavegarACommand}" CommandParameter="Lotes"
                                Style="{StaticResource SecondaryShortcutButtonStyle}" Margin="4" Padding="12,10"
                                ToolTip="Registrar nuevos lotes de compras, costos y vencimientos.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📦 " FontSize="14" />
                                <TextBlock Text="Lotes &amp; Vencimientos" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <!-- Atajo 8: Proveedores -->
                        <Button Command="{Binding NavegarACommand}" CommandParameter="Proveedores"
                                Style="{StaticResource SecondaryShortcutButtonStyle}" Margin="4" Padding="12,10"
                                ToolTip="Consultar teléfonos, datos y directorio de proveedores.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🏭 " FontSize="14" />
                                <TextBlock Text="Directorio Proveedores" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <!-- Atajo 9: Auditoría -->
                        <Button Command="{Binding NavegarACommand}" CommandParameter="Auditoria"
                                Style="{StaticResource SecondaryShortcutButtonStyle}" Margin="4" Padding="12,10"
                                ToolTip="Revisar el historial de auditoría y modificar ventas.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🛡️ " FontSize="14" />
                                <TextBlock Text="Auditoría de Ventas" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
