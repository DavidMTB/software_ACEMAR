<UserControl x:Class="software_ACEMAR.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:software_ACEMAR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="1000"
             Background="#F4F6F0"
             AutomationProperties.Name="Panel de Gestión de Usuarios y Vendedores">

    <UserControl.Resources>
        <views:ActiveTabBackgroundConverter x:Key="ActiveBgConv" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Cabecera -->
            <RowDefinition Height="Auto" />
            <!-- Barra de Herramientas y Búsqueda -->
            <RowDefinition Height="Auto" />
            <!-- Tabla de Usuarios -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. CABECERA -->
        <Border Grid.Row="0" Background="#FFFFFF" Padding="16,14" CornerRadius="10" BorderBrush="#DCDEC8" BorderThickness="1" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1D2611" Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0">
                    <TextBlock Text="👥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Gestión de Usuarios y Vendedores" FontSize="18" FontWeight="Black" Foreground="#1E2514" />
                    <TextBlock Text="Panel reservado para Administradores. Alta, edición y baja de accesos de vendedores para mostradores." FontSize="11" Foreground="#667056" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. BARRA DE HERRAMIENTAS -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Búsqueda -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCDEC8" BorderThickness="1" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍 " FontSize="14" VerticalAlignment="Center" Foreground="#4A5D23" />
                    <TextBox Grid.Column="1" 
                             Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="13" 
                             BorderThickness="0" 
                             Background="Transparent" 
                             VerticalAlignment="Center"
                             ToolTip="Buscar vendedor por nombre" />
                </Grid>
            </Border>

            <!-- Botón Registrar Vendedor -->
            <Button Grid.Column="2" 
                    Command="{Binding AbrirNuevoUsuarioCommand}"
                    Background="#1D2611" 
                    Foreground="#FFFFFF" 
                    BorderThickness="0" 
                    Padding="16,10" 
                    FontSize="13" 
                    FontWeight="Bold" 
                    Cursor="Hand"
                    ToolTip="Registrar un nuevo usuario vendedor (solo requiere nombre y contraseña)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕ Registrar Nuevo Vendedor" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 3. TABLA DE VENDEDORES -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCDEC8" BorderThickness="1" Padding="12">
            <DataGrid ItemsSource="{Binding Usuarios}" 
                      SelectedItem="{Binding UsuarioSeleccionado}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAECE4"
                      Background="Transparent" 
                      RowHeight="44"
                      ColumnHeaderHeight="38"
                      FontSize="13">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F4F6F0" />
                        <Setter Property="Foreground" Value="#354318" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                        <Setter Property="BorderBrush" Value="#C5D1BC" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />

                    <DataGridTemplateColumn Header="Usuario / Nombre Vendedor" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#EAF0E1" Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0">
                                        <TextBlock Text="👤" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding NombreUsuario}" FontWeight="Bold" Foreground="#1E2514" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Rol de Sistema" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,4" CornerRadius="6" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EAF0E1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Rol}" Value="Administrador">
                                                    <Setter Property="Background" Value="#FFF3E0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Rol}" FontWeight="Bold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#354318" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rol}" Value="Administrador">
                                                        <Setter Property="Foreground" Value="#E65100" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Mostrador Asignado" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🖥️ " FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding MostradorAsignado}" FontWeight="Bold" Foreground="#4A5D23" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Contraseña" Binding="{Binding Password}" Width="140" />

                    <DataGridTemplateColumn Header="Acciones" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- Botón Editar -->
                                    <Button Command="{Binding DataContext.EditarUsuarioCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Content="✏️ Editar" 
                                            Padding="8,4" 
                                            Margin="0,0,6,0"
                                            Background="#F1F5EC" 
                                            Foreground="#354318" 
                                            BorderBrush="#C5D1BC" 
                                            BorderThickness="1" 
                                            FontSize="11" 
                                            FontWeight="Bold" 
                                            Cursor="Hand" />

                                    <!-- Botón Eliminar -->
                                    <Button Command="{Binding DataContext.EliminarUsuarioCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            Content="🗑️ Eliminar" 
                                            Padding="8,4" 
                                            Background="#FFEBEE" 
                                            Foreground="#C62828" 
                                            BorderBrush="#FFCDD2" 
                                            BorderThickness="1" 
                                            FontSize="11" 
                                            FontWeight="Bold" 
                                            Cursor="Hand" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. MODAL PARA REGISTRO Y EDICIÓN -->
        <Grid Grid.RowSpan="3" Visibility="{Binding MostrarFormularioModal, Converter={x:Static views:Converters.BooleanToVisibility}}" Background="#80000000">
            <Border Background="#FFFFFF" CornerRadius="12" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" BorderBrush="#1D2611" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.3" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <!-- Título Modal -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="👤 " FontSize="20" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EsModoEdicion, Converter={x:Static views:Converters.BooleanToVisibility}, StringFormat={}{0}}" FontSize="18" FontWeight="Black" Foreground="#1E2514">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Registrar Nuevo Vendedor" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsModoEdicion}" Value="True">
                                            <Setter Property="Text" Value="Editar Vendedor" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Separator Background="#DCE3D6" Margin="0,0,0,18" />

                    <!-- Campo Nombre de Usuario -->
                    <TextBlock Text="Nombre del Vendedor:" FontSize="13" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,6" />
                    <TextBox Text="{Binding FormNombreUsuario, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="14" 
                             Padding="10,8" 
                             Background="#F8FAF5" 
                             BorderBrush="#C5D1BC" 
                             BorderThickness="1.5" 
                             Margin="0,0,0,16" 
                             ToolTip="Nombre de usuario para el inicio de sesión del vendedor (Ej: vendedor6, Pedro, Maria)" />

                    <!-- Campo Mostrador Asignado -->
                    <TextBlock Text="Mostrador Asignado:" FontSize="13" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding MostradoresDisponibles}" 
                              SelectedItem="{Binding FormMostradorAsignado}" 
                              FontSize="14" 
                              Padding="10,8" 
                              Background="#F8FAF5" 
                              BorderBrush="#C5D1BC" 
                              BorderThickness="1.5" 
                              Margin="0,0,0,16" 
                              ToolTip="Seleccione la estación o mostrador asignado a este vendedor" />

                    <!-- Campo Contraseña -->
                    <TextBlock Text="Contraseña del Vendedor:" FontSize="13" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,6" />
                    <TextBox Text="{Binding FormPassword, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="14" 
                             Padding="10,8" 
                             Background="#F8FAF5" 
                             BorderBrush="#C5D1BC" 
                             BorderThickness="1.5" 
                             Margin="0,0,0,14" 
                             ToolTip="Contraseña asignada para el vendedor" />

                    <!-- Mensaje de Error si aplica -->
                    <TextBlock Text="{Binding MensajeErrorForm}" 
                               Foreground="#C62828" 
                               FontWeight="Bold" 
                               FontSize="12" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,10" 
                               Visibility="{Binding MensajeErrorForm, Converter={x:Static views:Converters.StringToVisibility}}" />

                    <!-- Botones Modal -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="Cancelar" 
                                Command="{Binding CancelarFormularioCommand}" 
                                Background="#F1F5EC" 
                                Foreground="#354318" 
                                BorderBrush="#C5D1BC" 
                                BorderThickness="1" 
                                FontSize="13" 
                                FontWeight="Bold" 
                                Padding="10,10" 
                                Cursor="Hand" />

                        <Button Grid.Column="2" 
                                Content="💾 Guardar" 
                                Command="{Binding GuardarUsuarioCommand}" 
                                Background="#1D2611" 
                                Foreground="#FFFFFF" 
                                BorderThickness="0" 
                                FontSize="13" 
                                FontWeight="Black" 
                                Padding="10,10" 
                                Cursor="Hand" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
