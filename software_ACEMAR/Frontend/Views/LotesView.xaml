<UserControl x:Class="software_ACEMAR.Views.LotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:software_ACEMAR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER & FILTROS -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" Padding="12" BorderBrush="#DCE3D6" BorderThickness="1" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.05" Color="#1E2514" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Control de Lotes y Despacho FIFO" FontSize="16" FontWeight="Bold" Foreground="#1E2514" />
                    <TextBlock Text="Garantiza primero la salida de lotes en orden de ingreso al almacén" FontSize="11" Foreground="#556049" Margin="0,1,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Filtrar Producto:" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1E2514" Margin="0,0,8,0" />
                <ComboBox Grid.Column="2" 
                          ItemsSource="{Binding ProductosDisponibles}" 
                          SelectedItem="{Binding ProductoFiltro}" 
                          DisplayMemberPath="Nombre" 
                          Height="30" 
                          FontSize="12" 
                          VerticalContentAlignment="Center" />

                <Button Grid.Column="4" 
                        Content="🔄 REFRESCAR" 
                        Command="{Binding RefrescarLotesCommand}" 
                        Height="30" 
                        Padding="12,0" 
                        FontSize="12" 
                        FontWeight="Bold" 
                        Foreground="#FFFFFF" 
                        Cursor="Hand" />
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL: DATAGRID LOTES + REGISTRO -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- GRILLA DE LOTES -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCE3D6" BorderThickness="1" Padding="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#1E2514" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Inventario por Lote (Ingreso, Proveedores &amp; Costos FIFO)" FontSize="15" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,8" />

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Lotes}" 
                              SelectedItem="{Binding LoteSeleccionado}"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False" 
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF2E8"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#FFFFFF"
                              BorderBrush="#DCE3D6"
                              BorderThickness="1"
                              RowHeight="34"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lote N°" Binding="{Binding Id, StringFormat={}{0:D4}}" Width="65" FontWeight="Bold" />
                            <DataGridTextColumn Header="Producto" Binding="{Binding Producto.Nombre}" Width="1.5*" FontWeight="Bold" />
                            <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombreDisplay}" Width="1.2*" />
                            <DataGridTextColumn Header="Stock Disp." Binding="{Binding CantidadDisponible, StringFormat={}{0:N2}}" Width="80" FontWeight="Bold" />
                            <DataGridTextColumn Header="Costo" Binding="{Binding CostoCompra, StringFormat={}S/ {0:N2}}" Width="75" />
                            <DataGridTextColumn Header="P. Venta" Binding="{Binding PrecioVenta, StringFormat={}S/ {0:N2}}" Width="75" FontWeight="Bold" Foreground="#4A5D23" />
                            <DataGridTextColumn Header="Ingreso" Binding="{Binding FechaIngreso, StringFormat={}{0:dd/MM/yyyy}}" Width="85" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="65" FontWeight="SemiBold" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="⚠️ AGOTAR / CERRAR LOTE" 
                                Command="{Binding DesactivarLoteCommand}" 
                                CommandParameter="{Binding LoteSeleccionado}"
                                Height="32" Padding="12,0" Background="#C62828" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- FORMULARIO DE INGRESO DE NUEVO LOTE -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCE3D6" BorderThickness="1" Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#1E2514" />
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Ingreso de Nuevo Lote" FontSize="16" FontWeight="Bold" Foreground="#1E2514" />
                        <TextBlock Text="Registra nueva mercadería en almacén con costo y precio independiente" FontSize="11" Foreground="#556049" Margin="0,1,0,12" />

                        <!-- Seleccionar Producto -->
                        <TextBlock Text="Producto en Almacén:" FontSize="12" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding ProductosDisponibles}" 
                                  SelectedItem="{Binding FormProductoSeleccionado}" 
                                  DisplayMemberPath="Nombre" 
                                  Height="32" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,0,10" />

                        <!-- Seleccionar Proveedor -->
                        <TextBlock Text="Proveedor Suministrador:" FontSize="12" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding ProveedoresDisponibles}" 
                                  SelectedItem="{Binding FormProveedorSeleccionado}" 
                                  DisplayMemberPath="Nombre" 
                                  Height="32" FontSize="12" VerticalContentAlignment="Center" Background="#F8FAF5" BorderBrush="#C5D1BC" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cantidad Inicial:" FontSize="12" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormCantidadInicial, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="30" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F8FAF5" BorderBrush="#C5D1BC" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Costo Compra (S/):" FontSize="12" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormCostoCompra, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="30" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F8FAF5" BorderBrush="#C5D1BC" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Precio Venta (S/):" FontSize="12" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormPrecioVenta, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="30" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F8FAF5" BorderBrush="#C5D1BC" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fecha Ingreso:" FontSize="12" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding FormFechaIngreso}" Height="30" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <!-- Ubicación Almacén -->
                        <TextBlock Text="Ubicación Física en Almacén:" FontSize="12" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormUbicacionAlmacen, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="30" FontSize="12" Padding="4" VerticalContentAlignment="Center" Background="#F8FAF5" BorderBrush="#C5D1BC" Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="LIMPIAR" Command="{Binding LimpiarFormularioCommand}" Height="36" FontSize="12" FontWeight="Bold" Background="#9E9E9E" Foreground="#FFFFFF" Cursor="Hand" />
                            <Button Grid.Column="2" Content="📦 REGISTRAR LOTE" Command="{Binding RegistrarLoteCommand}" Height="36" FontSize="12" FontWeight="Bold" Background="#4A5D23" Foreground="#FFFFFF" Cursor="Hand" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
