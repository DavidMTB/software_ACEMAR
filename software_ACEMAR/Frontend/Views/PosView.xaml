<UserControl x:Class="software_ACEMAR.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:software_ACEMAR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource BackgroundBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO: CATÁLOGO Y BÚSQUEDA MANUAL -->
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCE3D6" BorderThickness="1" Padding="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#1E2514" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Título del Catálogo -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Catálogo de Productos Ferreteros" FontSize="16" FontWeight="Bold" Foreground="#1E2514" />
                    <TextBlock Text="Búsqueda manual por nombre o código para mostrador" FontSize="11" Foreground="#556049" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Barra de Búsqueda Manual -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F8FAF5" CornerRadius="6" BorderBrush="#C5D1BC" BorderThickness="1" Padding="4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#4A5D23" />
                            <TextBox Grid.Column="1" 
                                     Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="14" 
                                     FontWeight="SemiBold"
                                     Foreground="#1E2514"
                                     BorderThickness="0" 
                                     Background="Transparent" 
                                     VerticalContentAlignment="Center"
                                     Padding="4,6" />
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" 
                            Content="Limpiar" 
                            Command="{Binding LimpiarBusquedaCommand}" 
                            FontSize="12" 
                            FontWeight="SemiBold"
                            Padding="12,6" 
                            Background="#E8EEDF" 
                            Foreground="#354318" 
                            BorderBrush="#C5D1BC" 
                            BorderThickness="1" 
                            Cursor="Hand" />
                </Grid>

                <!-- Lista de Productos -->
                <DataGrid Grid.Row="2" 
                          ItemsSource="{Binding ProductosFiltrados}" 
                          SelectedItem="{Binding ProductoSeleccionado}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF2E8"
                          Background="#FFFFFF"
                          BorderBrush="#DCE3D6"
                          BorderThickness="1"
                          RowHeight="36"
                          FontSize="13"
                          Margin="0,0,0,10">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="75" FontWeight="SemiBold" />
                        
                        <DataGridTemplateColumn Header="Producto" Width="*" SortMemberPath="Nombre">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding Nombre}" FontWeight="Bold" Foreground="#1E2514" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Categoria}" FontSize="11" Foreground="#667554" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Stock" Width="100" SortMemberPath="StockActual">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                        <TextBlock Text="{Binding StockActual, StringFormat={}{0:0.##}}" FontWeight="Bold" FontSize="13" Foreground="#354318" />
                                        <TextBlock Text="{Binding UnidadMedida, StringFormat={} {0}}" FontSize="11" Foreground="#556049" VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                        <Border Background="#FFF3E0" CornerRadius="4" Padding="3,1" Margin="4,0,0,0"
                                                Visibility="{Binding EsStockBajo, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{Binding StockMinimo, StringFormat={}Alerta: Stock por debajo o igual al límite mínimo ({0:0.##})}">
                                            <TextBlock Text="⚠️" FontSize="10" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Precio" Width="85" SortMemberPath="PrecioUnitario">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PrecioUnitario, StringFormat={}S/ {0:N2}}" 
                                               FontWeight="Bold" 
                                               FontSize="13" 
                                               Foreground="#4A5D23" 
                                               VerticalAlignment="Center" 
                                               Margin="2,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Panel de Selección de Cantidad y Botón de Agregar -->
                <Border Grid.Row="3" Background="#F4F7EF" CornerRadius="6" Padding="10" BorderBrush="#D4DFCA" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Indicador del producto seleccionado y su precio según unidad -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Producto Seleccionado:" FontSize="11" Foreground="#556049" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProductoSeleccionado.Nombre, FallbackValue='(Seleccione un producto de la lista arriba)'}" 
                                           FontSize="13" 
                                           FontWeight="Bold" 
                                           Foreground="#354318" 
                                           TextTrimming="CharacterEllipsis" 
                                           Margin="0,1,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Precio U.M: " FontSize="11" Foreground="#556049" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PrecioUnitarioSeleccionado, StringFormat={}S/ {0:N2}}" 
                                           FontSize="14" 
                                           FontWeight="Bold" 
                                           Foreground="#4A5D23" 
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Cantidad Fraccionaria + Botón Agregar -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="Cant:" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center" 
                                       Foreground="#1E2514" 
                                       Margin="0,0,6,0" />

                            <!-- Entrada decimal / fraccionaria -->
                            <TextBox Grid.Column="1" 
                                     Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="15" 
                                     FontWeight="Bold" 
                                     HorizontalContentAlignment="Center" 
                                     VerticalContentAlignment="Center" 
                                     Background="#FFFFFF" 
                                     BorderBrush="#4A5D23" 
                                     BorderThickness="1.5" 
                                     Padding="4,2" 
                                     Height="34" />

                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding UnidadesDisponiblesProducto}"
                                      SelectedItem="{Binding UnidadMedidaSeleccionada}"
                                      Height="34"
                                      FontSize="12"
                                      FontWeight="SemiBold"
                                      VerticalContentAlignment="Center"
                                      Background="#FFFFFF"
                                      MinWidth="75"
                                      Margin="4,0,0,0" />

                            <!-- Botón Agregar -->
                            <Button Grid.Column="4" 
                                    Content="➕ AGREGAR AL TICKET" 
                                    Command="{Binding AgregarAlTicketCommand}" 
                                    FontSize="13" 
                                    FontWeight="Bold" 
                                    Padding="10,0" 
                                    Height="34"
                                    Background="#4A5D23" 
                                    Foreground="#FFFFFF" 
                                    BorderThickness="0" 
                                    Cursor="Hand" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- PANEL DERECHO: TICKET DE VENTA Y TOTALES -->
        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCE3D6" BorderThickness="1" Padding="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#1E2514" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabecera del Ticket -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ticket de Venta Actual" FontSize="16" FontWeight="Bold" Foreground="#1E2514" />
                        <TextBlock Text="Mostrador Ferretería ACEMAR" FontSize="11" Foreground="#556049" Margin="0,1,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" 
                            Content="Vaciar" 
                            Command="{Binding CancelarTicketCommand}" 
                            FontSize="11" 
                            FontWeight="SemiBold" 
                            Background="#F8F9FA" 
                            Foreground="#C62828" 
                            BorderBrush="#EF9A9A" 
                            BorderThickness="1" 
                            Padding="8,4" 
                            Cursor="Hand" />
                </Grid>

                <!-- DataGrid del Ticket de Venta -->
                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding TicketActual}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF2E8"
                          Background="#FFFFFF"
                          BorderBrush="#DCE3D6"
                          BorderThickness="1"
                          RowHeight="34"
                          FontSize="12"
                          Margin="0,0,0,10">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding ProductoNombre}" Width="*" FontWeight="SemiBold" />
                        
                        <DataGridTemplateColumn Header="Cant." Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Cantidad, StringFormat={}{0:0.##}}" 
                                               FontWeight="Bold" 
                                               FontSize="12" 
                                               Foreground="#1E2514" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="P. Unit." Binding="{Binding PrecioUnitario, StringFormat={}S/ {0:N2}}" Width="70" />
                        
                        <DataGridTemplateColumn Header="Subtotal" Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Subtotal, StringFormat={}S/ {0:N2}}" 
                                               FontWeight="Bold" 
                                               FontSize="12" 
                                               Foreground="#4A5D23" 
                                               HorizontalAlignment="Right" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" 
                                            Command="{Binding DataContext.EliminarDelTicketCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" 
                                            Foreground="#D32F2F" 
                                            FontWeight="Bold" 
                                            FontSize="12" 
                                            Background="Transparent" 
                                            BorderThickness="0" 
                                            Cursor="Hand" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Desglose de Totales y Modalidad de Pago -->
                <Border Grid.Row="2" Background="#F8FAF5" CornerRadius="6" Padding="10" BorderBrush="#DCE3D6" BorderThickness="1" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Base Imponible:" FontSize="12" Foreground="#556049" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubtotalVenta, StringFormat={}S/ {0:N2}}" FontSize="12" FontWeight="SemiBold" Foreground="#1E2514" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="I.G.V. (18%):" FontSize="12" Foreground="#556049" Margin="0,1,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IgvVenta, StringFormat={}S/ {0:N2}}" FontSize="12" FontWeight="SemiBold" Foreground="#1E2514" Margin="0,1,0,0" />

                        <Separator Grid.Row="2" Grid.ColumnSpan="2" Background="#D4DFCA" Margin="0,1" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="TOTAL A COBRAR:" FontSize="14" FontWeight="Bold" Foreground="#354318" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalVenta, StringFormat={}S/ {0:N2}}" FontSize="20" FontWeight="ExtraBold" Foreground="#4A5D23" HorizontalAlignment="Right" />

                        <Separator Grid.Row="4" Grid.ColumnSpan="2" Background="#D4DFCA" Margin="0,2" />

                        <!-- Selector Modalidad de Cobro -->
                        <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,1,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Modalidad:" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1E2514" />
                            <ComboBox Grid.Column="2" SelectedValue="{Binding TipoVentaSeleccionado}" SelectedValuePath="Tag" Height="28" FontSize="12" VerticalContentAlignment="Center" Background="#FFFFFF">
                                <ComboBoxItem Content="💵 Al Contado (Efectivo)" Tag="Efectivo" IsSelected="True" />
                                <ComboBoxItem Content="📱 Al Contado (Yape / Plin / Transferencia)" Tag="Digital" />
                                <ComboBoxItem Content="💳 A Crédito (Fiado Autorizado)" Tag="Credito" />
                            </ComboBox>
                        </Grid>

                        <!-- Selector de Cliente Fiado (Visible solo si es crédito) -->
                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" 
                                    Visibility="{Binding EsVentaCredito, Converter={x:Static local:Converters.BooleanToVisibility}}" 
                                    Margin="0,2,0,0">
                            <TextBlock Text="Asignar al Cliente Fiado:" FontSize="11" FontWeight="Bold" Foreground="#B71C1C" Margin="0,0,0,1" />
                            <ComboBox ItemsSource="{Binding ClientesCredito}" 
                                      SelectedItem="{Binding ClienteCreditoSeleccionado}" 
                                      DisplayMemberPath="Nombre" 
                                      Height="28" 
                                      FontSize="12"
                                      Background="#FFF8F8" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock Text="Crédito Disp: " FontSize="10" Foreground="#556049" />
                                <TextBlock Text="{Binding ClienteCreditoSeleccionado.CreditoDisponible, StringFormat={}S/ {0:N2}}" FontWeight="Bold" FontSize="10" Foreground="#2E7D32" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Botones Principales: Finalizar Venta y Generar Proforma -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" 
                            Content="💳 COBRAR VENTA" 
                            Command="{Binding ProcesarVentaCommand}" 
                            FontSize="14" 
                            FontWeight="Bold" 
                            Height="38"
                            Background="#4A5D23" 
                            Foreground="#FFFFFF" 
                            BorderThickness="0" 
                            Cursor="Hand" />

                    <Button Grid.Column="2" 
                            Content="📄 PROFORMA" 
                            Command="{Binding GenerarProformaCommand}" 
                            FontSize="12" 
                            FontWeight="Bold" 
                            Height="38"
                            Background="#E8EEDF" 
                            Foreground="#354318" 
                            BorderBrush="#C5D1BC" 
                            BorderThickness="1" 
                            Cursor="Hand" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
