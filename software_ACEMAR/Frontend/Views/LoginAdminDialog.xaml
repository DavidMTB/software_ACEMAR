<Window x:Class="software_ACEMAR.Views.LoginAdminDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso Administrativo - Ferretería ACEMAR" 
        Height="420" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#4A5D23" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.25" Color="#1E2514" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Border Background="#354318" Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="🛡️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Autenticación de Gerencia" FontSize="20" FontWeight="Bold" Foreground="#1E2514" HorizontalAlignment="Center" />
                <TextBlock Text="Ingrese credenciales para modo Administrador" FontSize="12" Foreground="#556049" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <Separator Grid.Row="1" Background="#DCE3D6" Margin="0,0,0,20" />

            <!-- Campos de Formulario -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Usuario:" FontSize="13" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,6" />
                <TextBox x:Name="txtUsuario" 
                         FontSize="15" 
                         Padding="10,8" 
                         Background="#F8FAF5" 
                         BorderBrush="#C5D1BC" 
                         BorderThickness="1.5" 
                         Margin="0,0,0,16" />

                <TextBlock Text="Contraseña:" FontSize="13" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,6" />
                <PasswordBox x:Name="txtPassword" 
                             FontSize="16" 
                             Padding="10,8" 
                             Background="#F8FAF5" 
                             BorderBrush="#C5D1BC" 
                             BorderThickness="1.5" 
                             Margin="0,0,0,10" />

                <!-- Mensaje de Error -->
                <TextBlock x:Name="txtError" 
                           Foreground="#D32F2F" 
                           FontWeight="SemiBold" 
                           FontSize="12" 
                           TextWrapping="Wrap" 
                           Visibility="Collapsed" 
                           Margin="0,0,0,10" />

                <TextBlock Text="Credencial por defecto: Usuario: Gerente / Contraseña: acemar" 
                           FontSize="11" 
                           Foreground="#78909C" 
                           FontStyle="Italic" 
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Botones de Acción -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="Cancelar" 
                        Click="BtnCancelar_Click" 
                        Background="#F1F5EC" 
                        Foreground="#354318" 
                        BorderBrush="#C5D1BC" 
                        BorderThickness="1" 
                        FontSize="14" 
                        Padding="12,10" 
                        Cursor="Hand" />

                <Button Grid.Column="2" 
                        Content="🔐 Ingresar" 
                        Click="BtnIngresar_Click" 
                        Background="#4A5D23" 
                        Foreground="#FFFFFF" 
                        BorderThickness="0" 
                        FontSize="14" 
                        FontWeight="Bold" 
                        Padding="12,10" 
                        Cursor="Hand" />
            </Grid>
        </Grid>
    </Border>
</Window>
