<UserControl x:Class="software_ACEMAR.Views.ProductCrudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:software_ACEMAR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Panel Superior de Actualización Masiva de Precios -->
            <RowDefinition Height="Auto" />
            <!-- Cuerpo Principal con Tabla y Formulario -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- PANEL SUPERIOR: ACTUALIZACIÓN MASIVA DE PRECIOS -->
        <Border Grid.Row="0" Background="#F4F7EF" CornerRadius="8" Padding="10" BorderBrush="#C5D1BC" BorderThickness="1.5" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.05" Color="#1E2514" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#4A5D23" Width="36" Height="36" CornerRadius="6">
                    <TextBlock Text="📈" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Actualización Masiva de Precios" FontSize="14" FontWeight="Bold" Foreground="#1E2514" />
                    <TextBlock Text="Ajuste porcentual por categoría o catálogo global" FontSize="11" Foreground="#556049" />
                </StackPanel>

                <!-- Categoría -->
                <TextBlock Grid.Column="4" Text="Categoría:" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1E2514" />
                <ComboBox Grid.Column="5" 
                          ItemsSource="{Binding CategoriasDisponibles}" 
                          SelectedItem="{Binding CategoriaAumento}" 
                          Height="32" 
                          FontSize="12" 
                          VerticalContentAlignment="Center" 
                          Background="#FFFFFF" />

                <!-- Porcentaje -->
                <TextBlock Grid.Column="7" Text="% Cambio:" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1E2514" />
                <TextBox Grid.Column="8" 
                         Text="{Binding PorcentajeAumentoTexto, UpdateSourceTrigger=PropertyChanged}" 
                         Height="32" 
                         FontSize="14" 
                         FontWeight="Bold" 
                         VerticalContentAlignment="Center" 
                         HorizontalContentAlignment="Center" 
                         Background="#FFFFFF" 
                         BorderBrush="#4A5D23" 
                         BorderThickness="1.5" />

                <!-- Botón Aplicar -->
                <Button Grid.Column="10" 
                        Content="⚡ APLICAR PRECIOS" 
                        Command="{Binding AplicarAumentoMasivoCommand}" 
                        Height="32" 
                        Padding="12,0" 
                        FontSize="12" 
                        FontWeight="Bold" 
                        Background="#4A5D23" 
                        Foreground="#FFFFFF" 
                        Cursor="Hand" />
            </Grid>
        </Border>

        <!-- CUERPO PRINCIPAL: TABLA DE PRODUCTOS Y FORMULARIO CRUD -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- TABLA DE PRODUCTOS (LISTA Y ACCIONES) -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCE3D6" BorderThickness="1" Padding="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#1E2514" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabecera y Buscador -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Inventario General de Productos" FontSize="16" FontWeight="Bold" Foreground="#1E2514" />
                            <TextBlock Text="Seleccione una fila para editar" FontSize="11" Foreground="#556049" />
                        </StackPanel>

                        <Border Grid.Column="1" Background="#F8FAF5" CornerRadius="6" BorderBrush="#C5D1BC" BorderThickness="1" Padding="4,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" FontSize="12" Foreground="#4A5D23" />
                                <TextBox Grid.Column="1" 
                                         Text="{Binding BusquedaTexto, UpdateSourceTrigger=PropertyChanged}" 
                                         BorderThickness="0" 
                                         Background="Transparent" 
                                         FontSize="12" 
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- DataGrid de Productos -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Productos}" 
                              SelectedItem="{Binding ProductoSeleccionado}"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF2E8"
                              Background="#FFFFFF"
                              BorderBrush="#DCE3D6"
                              BorderThickness="1"
                              RowHeight="36"
                              FontSize="13">
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="75" FontWeight="Bold" />
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="95" />
                            <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitario, StringFormat={}S/ {0:N2}}" Width="80" FontWeight="Bold" />
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockActual, StringFormat={}{0:0.##}}" Width="65" />
                            <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadMedida}" Width="65" />

                            <!-- Botón Eliminar -->
                            <DataGridTemplateColumn Header="Acción" Width="48">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️" 
                                                Command="{Binding DataContext.EliminarProductoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                FontSize="12" 
                                                Cursor="Hand" 
                                                ToolTip="Eliminar Producto" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- FORMULARIO CREAR / EDITAR PRODUCTO -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCE3D6" BorderThickness="1" Padding="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#1E2514" />
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding EsModoEdicion, Converter={x:Static local:Converters.BooleanToVisibility}, FallbackValue='Nuevo Producto'}" 
                                       FontSize="16" FontWeight="Bold" Foreground="#354318" />
                            <TextBlock Text="Complete los datos del producto" FontSize="11" Foreground="#556049" Margin="0,1,0,0" />
                        </StackPanel>

                        <!-- Código -->
                        <TextBlock Text="Código:" FontSize="12" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,2" />
                        <TextBox Text="{Binding FormCodigo, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13" Padding="6,4" Background="#F8FAF5" Margin="0,0,0,8" />

                        <!-- Nombre -->
                        <TextBlock Text="Nombre / Descripción:" FontSize="12" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,2" />
                        <TextBox Text="{Binding FormNombre, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13" Padding="6,4" Background="#F8FAF5" Margin="0,0,0,8" />

                        <!-- Categoría -->
                        <TextBlock Text="Categoría:" FontSize="12" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,2" />
                        <TextBox Text="{Binding FormCategoria, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13" Padding="6,4" Background="#F8FAF5" Margin="0,0,0,8" />

                        <!-- Precio Base Principal -->
                        <TextBlock Text="Precio Base (S/):" FontSize="12" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,2" />
                        <TextBox Text="{Binding FormPrecio, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="15" FontWeight="Bold" Foreground="#4A5D23" Padding="6,4" Background="#F8FAF5" Margin="0,0,0,8" />

                        <!-- Configuración de Unidades de Medida y Precios Específicos -->
                        <!-- Configuración de Unidades de Medida y Precios Específicos -->
                        <Expander Header="📐 UNIDADES DE MEDIDA Y PRECIOS POR UNIDAD" 
                                  IsExpanded="True" 
                                  FontSize="11" 
                                  FontWeight="Bold" 
                                  Foreground="#354318" 
                                  Margin="0,0,0,10">
                            <Border Background="#F4F7EF" CornerRadius="6" BorderBrush="#DCE3D6" BorderThickness="1" Padding="8" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="Seleccione unidades habilitadas, asigne su precio y factor de equivalencia en stock base:" 
                                               FontSize="10" Foreground="#556049" Margin="0,0,0,6" TextWrapping="Wrap" />

                                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ListaUnidadesPrecios}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="4" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" 
                                                                  IsChecked="{Binding EstaSeleccionada, Mode=TwoWay}" 
                                                                  VerticalAlignment="Center" Margin="0,0,6,0" />

                                                        <TextBlock Grid.Column="1" 
                                                                   Text="{Binding NombreUnidad}" 
                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#1E2514" VerticalAlignment="Center" />

                                                        <TextBox Grid.Column="2" 
                                                                 Text="{Binding PrecioTexto, UpdateSourceTrigger=PropertyChanged}" 
                                                                 FontSize="11" FontWeight="Bold" Foreground="#2A3814" 
                                                                 ToolTip="Precio de venta (S/)"
                                                                 Padding="4,2" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Background="#FFFFFF" />

                                                        <TextBox Grid.Column="4" 
                                                                 Text="{Binding FactorTexto, UpdateSourceTrigger=PropertyChanged}" 
                                                                 FontSize="11" Foreground="#444444" 
                                                                 ToolTip="Equivalencia en stock base (Ej: Volquetada = 4 Metros, Lata = 0.1)"
                                                                 Padding="3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#FFFFFF" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <!-- Agregar nueva unidad personalizada -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" 
                                                 Text="{Binding NuevaUnidadNombre, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontSize="11" Padding="4,2" Background="#FFFFFF" 
                                                 ToolTip="Escriba el nombre de una nueva unidad (ej: Cajón, Atado, Balde)" />

                                        <Button Grid.Column="2" 
                                                Content="➕ Agregar" 
                                                Command="{Binding AgregarNuevaUnidadCommand}" 
                                                FontSize="11" FontWeight="Bold" Padding="8,2" 
                                                Background="#4A5D23" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Stock Actual, Stock Mínimo y CuMax -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Stock Act:" FontSize="11" FontWeight="Bold" Foreground="#1E2514" />
                                    <TextBlock Text=" (Lotes)" FontSize="9" Foreground="#666666" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBox Text="{Binding FormStockActual, UpdateSourceTrigger=PropertyChanged}" 
                                         IsReadOnly="True"
                                         ToolTip="El stock se incrementa únicamente al registrar un nuevo lote en 'Lotes &amp; Vencimientos'."
                                         FontSize="13" HorizontalContentAlignment="Center" Padding="4" Background="#EAECE4" Foreground="#555555" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Stock Mín:" FontSize="11" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,2" />
                                <TextBox Text="{Binding FormStockMinimo, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="13" HorizontalContentAlignment="Center" Padding="4" Background="#F8FAF5" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="CuMax:" FontSize="11" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,2" />
                                <TextBox Text="{Binding FormCuMax, UpdateSourceTrigger=PropertyChanged}" 
                                         FontSize="13" HorizontalContentAlignment="Center" Padding="4" Background="#F8FAF5" />
                            </StackPanel>
                        </Grid>

                        <!-- Botones Guardar y Limpiar -->
                        <Button Content="💾 GUARDAR PRODUCTO" 
                                Command="{Binding GuardarProductoCommand}" 
                                FontSize="13" FontWeight="Bold" 
                                Padding="10" Height="36"
                                Background="#4A5D23" 
                                Foreground="#FFFFFF" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                Margin="0,0,0,8" />

                        <Button Content="🔄 Limpiar / Nuevo Registro" 
                                Command="{Binding LimpiarFormularioCommand}" 
                                FontSize="12" 
                                FontWeight="SemiBold" 
                                Padding="8" 
                                Background="#E8EEDF" 
                                Foreground="#354318" 
                                BorderBrush="#C5D1BC" 
                                BorderThickness="1" 
                                Cursor="Hand" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
