<UserControl x:Class="software_ACEMAR.Views.VentasCorreccionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:software_ACEMAR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER & BUSQUEDA DE VENTAS -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" Padding="12" BorderBrush="#DCE3D6" BorderThickness="1" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.05" Color="#1E2514" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Auditoría y Corrección de Ventas Procesadas" FontSize="16" FontWeight="Bold" Foreground="#1E2514" />
                    <TextBlock Text="Permite rectificar errores en ventas ya emitidas, devolviendo stock a lotes y ajustando cuentas por cobrar" FontSize="11" Foreground="#556049" Margin="0,1,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Buscar Venta / Cliente:" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1E2514" Margin="0,0,8,0" />
                <TextBox Grid.Column="2" Text="{Binding BusquedaVenta, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="12" Padding="4" VerticalContentAlignment="Center" Background="#F8FAF5" BorderBrush="#C5D1BC" />

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="🔍 BUSCAR" Command="{Binding BuscarVentasCommand}" Height="30" Padding="10,0" FontSize="11" FontWeight="Bold" Background="#4A5D23" Foreground="#FFFFFF" Cursor="Hand" Margin="0,0,6,0" />
                    <Button Content="📄 BOLETA PDF" Command="{Binding VerBoletaPdfCommand}" Height="30" Padding="10,0" FontSize="11" FontWeight="Bold" Background="#2563EB" Foreground="#FFFFFF" Cursor="Hand" Margin="0,0,6,0" ToolTip="Generar y abrir Boleta en PDF A4" />
                    <Button Content="🧾 TICKET PDF" Command="{Binding VerTicketTermicoPdfCommand}" Height="30" Padding="10,0" FontSize="11" FontWeight="Bold" Background="#059669" Foreground="#FFFFFF" Cursor="Hand" ToolTip="Generar y abrir Ticket Térmico 80mm PDF" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO: LISTA VENTAS + DETALLES + AUDITORIA EDITABLE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <!-- GRILLA VENTAS RECIENTES -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCE3D6" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Histórico de Ventas" FontSize="14" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,6" />

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Ventas}" 
                              SelectedItem="{Binding VentaSeleccionada}"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              RowHeight="32"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id, StringFormat={}{0:D6}}" Width="55" FontWeight="Bold" />
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM HH:mm}}" Width="85" />
                            <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoVenta}" Width="65" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}S/ {0:N2}}" Width="75" FontWeight="Bold" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- DETALLE DE LA VENTA SELECCIONADA Y PANEL DE CORRECCIÓN AUDITADA -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!-- DETALLES DE PRODUCTO DE LA VENTA -->
                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCE3D6" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Ítems de Venta N° " FontSize="14" FontWeight="Bold" Foreground="#1E2514" />
                            <TextBlock Text="{Binding VentaSeleccionada.Id, StringFormat={}{0:D6}}" FontSize="14" FontWeight="Bold" Foreground="#2563EB" />
                            <TextBlock Text=" (Seleccione un renglón a corregir)" FontSize="11" Foreground="#64748B" Margin="6,2,0,0" />
                        </StackPanel>

                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding DetallesVenta}" 
                                  SelectedItem="{Binding DetalleSeleccionado}"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="32"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding ProductoCodigo}" Width="80" />
                                <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat={}{0:N2}}" Width="70" FontWeight="Bold" />
                                <DataGridTextColumn Header="U.M." Binding="{Binding UnidadMedida}" Width="60" />
                                <DataGridTextColumn Header="P. Unit" Binding="{Binding PrecioUnitario, StringFormat={}S/ {0:N2}}" Width="75" />
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}S/ {0:N2}}" Width="80" FontWeight="Bold" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- FORMULARIO DE EDICIÓN AUDITADA & HISTORIAL DE AUDITORÍA -->
                <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCE3D6" BorderThickness="1" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- FORMULARIO DE MODIFICACIÓN -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Rectificación de Renglón Seleccionado" FontSize="13" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Nueva Cantidad:" FontSize="11" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding NuevaCantidadTexto, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F8FAF5" BorderBrush="#C5D1BC" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Nuevo Precio (S/):" FontSize="11" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding NuevoPrecioTexto, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="12" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#F8FAF5" BorderBrush="#C5D1BC" />
                                </StackPanel>
                            </Grid>

                            <!-- Motivo de Auditoría Obligatorio -->
                            <TextBlock Text="Motivo de Auditoría (OBLIGATORIO):" FontSize="11" FontWeight="Bold" Foreground="#D32F2F" Margin="0,0,0,2" />
                            <TextBox Text="{Binding MotivoAuditoria, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="42" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="💾 GUARDAR CORRECCIÓN" Command="{Binding GuardarCorreccionCommand}" Height="32" FontSize="11" FontWeight="Bold" Background="#2563EB" Foreground="#FFFFFF" Cursor="Hand" />
                                <Button Grid.Column="2" Content="❌ ANULAR VENTA" Command="{Binding AnularVentaCompletaCommand}" Height="32" Padding="8,0" FontSize="11" FontWeight="Bold" Background="#DC2626" Foreground="#FFFFFF" Cursor="Hand" />
                            </Grid>
                        </StackPanel>

                        <!-- BITÁCORA DE AUDITORÍA -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Bitácora de Cambios" FontSize="12" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />

                            <DataGrid Grid.Row="1" 
                                      ItemsSource="{Binding HistorialAuditoria}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      RowHeight="28"
                                      FontSize="10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaModificacion, StringFormat={}{0:dd/MM HH:mm}}" Width="75" />
                                    <DataGridTextColumn Header="Descripción / Motivo" Binding="{Binding Descripcion}" Width="*" />
                                    <DataGridTextColumn Header="Usuario" Binding="{Binding UsuarioModifica}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
