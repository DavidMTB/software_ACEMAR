<UserControl x:Class="software_ACEMAR.Views.AiAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:software_ACEMAR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Fila 0: Header & Estado -->
            <RowDefinition Height="Auto" />
            <!-- Fila 1: Panel de Configuración Colapsable -->
            <RowDefinition Height="Auto" />
            <!-- Fila 2: Barra de Acciones Rápidas / Prompts Predefinidos -->
            <RowDefinition Height="Auto" />
            <!-- Fila 3: Contenedor Principal de Conversación -->
            <RowDefinition Height="*" />
            <!-- Fila 4: Indicador de Carga / Spinner -->
            <RowDefinition Height="Auto" />
            <!-- Fila 5: Caja de Entrada y Envío -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- FILA 0: ENCABEZADO EJECUTIVO Y ESTADO DE CONEXIÓN              -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="8" Padding="14,10" BorderBrush="#DCE3D6" BorderThickness="1" Margin="0,0,0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.05" Color="#1E2514" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#4A5D23" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,0">
                            <TextBlock Text="🧠" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ACEMAR IA • Asistente Ejecutivo Inteligente (Google Gemini)" FontSize="16" FontWeight="Black" Foreground="#1E2514" VerticalAlignment="Center" />
                        <Border Background="#F1F5F9" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" BorderBrush="#CBD5E1" BorderThickness="1">
                            <TextBlock Text="{Binding EstadoConexion}" FontSize="11" FontWeight="Bold" Foreground="#334155" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Diagnóstico estratégico automático, análisis de inventario FIFO, detección de morosidad y asesoría gerencial continua." 
                               FontSize="11" Foreground="#556049" Margin="38,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚙️ CONFIGURAR API KEY" Command="{Binding AlternarConfiguracionCommand}" 
                            Height="32" Padding="12,0" FontSize="11" FontWeight="Bold" Background="#F0F4E8" Foreground="#354318" 
                            BorderBrush="#B5C6A0" BorderThickness="1" Cursor="Hand" Margin="0,0,6,0" />
                    <Button Content="🗑️ LIMPIAR CHAT" Command="{Binding LimpiarChatCommand}" 
                            Height="32" Padding="12,0" FontSize="11" FontWeight="Bold" Background="#F1F5F9" Foreground="#64748B" 
                            BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- FILA 1: PANEL COLAPSABLE DE CONFIGURACIÓN API KEY GEMINI       -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Background="#FFFBEB" CornerRadius="8" Padding="12" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,0,8"
                Visibility="{Binding MostrarConfiguracion, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="🔑 Configuración de API Key para Google Gemini" FontSize="13" FontWeight="Bold" Foreground="#B45309" />
                    <TextBlock Text="Ingresa tu clave de API de Google Gemini (gratuita en https://aistudio.google.com). Si dejas el campo vacío, el sistema activará el Modo Demo Heurístico Local con los datos reales de SQLite." 
                               FontSize="11" Foreground="#78350F" Margin="0,2,0,8" TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}" 
                             Height="32" FontSize="12" Padding="6,4" VerticalContentAlignment="Center" Background="#FFFFFF" BorderBrush="#D97706" />

                    <Button Grid.Column="2" Content="💾 GUARDAR CLAVE" Command="{Binding GuardarApiKeyCommand}" 
                            Height="32" Padding="16,0" FontSize="11" FontWeight="Bold" Background="#D97706" Foreground="#FFFFFF" Cursor="Hand" />
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- FILA 2: ACCIONES RÁPIDAS (PROMPTS EJECUTIVOS PREDEFINIDOS)     -->
        <!-- ============================================================== -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="8" Padding="10,8" BorderBrush="#DCE3D6" BorderThickness="1" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Informes con 1 Clic:" FontSize="11" FontWeight="ExtraBold" Foreground="#1E2514" VerticalAlignment="Center" Margin="0,0,10,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🩺 Diagnóstico Integral" Command="{Binding GenerarDiagnosticoGeneralCommand}" 
                            Height="28" Padding="10,0" FontSize="11" FontWeight="Bold" Background="#4A5D23" Foreground="#FFFFFF" Cursor="Hand" Margin="0,0,6,0" ToolTip="Evalúa salud financiera general, ventas y alertas" />
                    <Button Content="📦 Auditoría de Stock" Command="{Binding GenerarDiagnosticoStockCommand}" 
                            Height="28" Padding="10,0" FontSize="11" FontWeight="Bold" Background="#2563EB" Foreground="#FFFFFF" Cursor="Hand" Margin="0,0,6,0" ToolTip="Productos bajo stock mínimo y compras a proveedores" />
                    <Button Content="💳 Cartera de Créditos" Command="{Binding GenerarDiagnosticoCreditosCommand}" 
                            Height="28" Padding="10,0" FontSize="11" FontWeight="Bold" Background="#D97706" Foreground="#FFFFFF" Cursor="Hand" Margin="0,0,6,0" ToolTip="Análisis de morosidad y deudas de clientes fiados" />
                    <Button Content="💡 Estrategias Comerciales" Command="{Binding GenerarEstrategiaComercialCommand}" 
                            Height="28" Padding="10,0" FontSize="11" FontWeight="Bold" Background="#7C3AED" Foreground="#FFFFFF" Cursor="Hand" ToolTip="Sugerencias de promociones y rotación de materiales" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- FILA 3: ÁREA PRINCIPAL DE CHAT / HISTORIAL CONVERSACIONAL      -->
        <!-- ============================================================== -->
        <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCE3D6" BorderThickness="1" Padding="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#1E2514" />
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Mensajes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" 
                                    HorizontalAlignment="{Binding Alineacion}" 
                                    MaxWidth="880"
                                    Background="{Binding BackgroundColor}"
                                    BorderBrush="{Binding BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14,10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.06" Color="#000000" />
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Cabecera de la burbuja (Emisor + Hora) -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icono}" FontSize="13" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Emisor}" FontWeight="ExtraBold" FontSize="11" Foreground="{Binding TextColor}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding HoraFormateada}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Contenido del Mensaje -->
                                    <TextBox Grid.Row="1" 
                                             Text="{Binding Contenido, Mode=OneWay}" 
                                             IsReadOnly="True" 
                                             TextWrapping="Wrap" 
                                             BorderThickness="0" 
                                             Background="Transparent" 
                                             Foreground="{Binding TextColor}" 
                                             FontSize="12.5" 
                                             FontFamily="Segoe UI"
                                             Cursor="Arrow" />

                                    <!-- Botón copiar respuesta (Solo para respuestas de la IA) -->
                                    <Button Grid.Row="2" 
                                            HorizontalAlignment="Right" 
                                            Margin="0,6,0,0"
                                            Padding="6,2" 
                                            FontSize="10" 
                                            FontWeight="Bold" 
                                            Background="#F1F5F9" 
                                            Foreground="#475569" 
                                            BorderBrush="#CBD5E1" 
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Content="📋 Copiar Respuesta"
                                            Command="{Binding DataContext.CopiarMensajeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Contenido}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsIa}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ============================================================== -->
        <!-- FILA 4: INDICADOR DE PROCESAMIENTO / CARGA                     -->
        <!-- ============================================================== -->
        <Border Grid.Row="4" Background="#EAF0E1" CornerRadius="6" Padding="10,6" Margin="0,6,0,6"
                Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="⏳ " FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TextoEstado}" FontSize="11" FontWeight="Bold" Foreground="#354318" />
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,3,0,0" Foreground="#4A5D23" Background="#DCE3D6" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- FILA 5: CAJA DE ENTRADA Y ENVÍO DE CONSULTA LIBRE              -->
        <!-- ============================================================== -->
        <Border Grid.Row="5" Background="#FFFFFF" CornerRadius="8" Padding="8" BorderBrush="#DCE3D6" BorderThickness="1" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                         Text="{Binding MensajeInput, UpdateSourceTrigger=PropertyChanged}" 
                         Height="42" 
                         FontSize="12.5" 
                         Padding="8,10" 
                         VerticalContentAlignment="Center" 
                         Background="#F8FAF5" 
                         BorderBrush="#C5D1BC"
                         BorderThickness="1">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding EnviarMensajeCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2" 
                        Command="{Binding EnviarMensajeCommand}" 
                        Height="42" 
                        Padding="18,0" 
                        FontSize="12" 
                        FontWeight="Bold" 
                        Background="#4A5D23" 
                        Foreground="#FFFFFF" 
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ " FontSize="14" />
                        <TextBlock Text="CONSULTAR A LA IA" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>

