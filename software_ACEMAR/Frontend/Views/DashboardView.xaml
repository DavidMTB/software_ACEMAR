<UserControl x:Class="software_ACEMAR.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:software_ACEMAR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- FILA 0: TARJETAS KPI DE RESUMEN INTELIGENTE -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Total Productos -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" Padding="12" BorderBrush="#DCE3D6" BorderThickness="1"
                    ToolTip="Número total de productos registrados en el catálogo de la ferretería.">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.05" Color="#1E2514" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Total de Productos" FontSize="12" Foreground="#556049" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalProductos}" FontSize="22" FontWeight="ExtraBold" Foreground="#354318" Margin="0,2,0,0" />
                    <TextBlock Text="Registrados en catálogo" FontSize="11" Foreground="#889876" Margin="0,1,0,0" />
                </StackPanel>
            </Border>

            <!-- KPI 2: Alerta Stock Bajo / Crítico -->
            <Border Grid.Column="2" Background="#FFF5F5" CornerRadius="8" Padding="12" BorderBrush="#FFCDD2" BorderThickness="1.5"
                    ToolTip="Cantidad de productos cuyo stock disponible es menor o igual a su límite de seguridad.">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08" Color="#D32F2F" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Alerta Stock Bajo" FontSize="12" Foreground="#C62828" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TotalProductosBajoStock}" FontSize="22" FontWeight="ExtraBold" Foreground="#D32F2F" Margin="0,2,0,0" />
                    <TextBlock Text="Requieren reposición" FontSize="11" Foreground="#E57373" FontWeight="SemiBold" Margin="0,1,0,0" />
                </StackPanel>
            </Border>

            <!-- KPI 3: Ventas del Día -->
            <Border Grid.Column="4" Background="#F0FDF4" CornerRadius="8" Padding="12" BorderBrush="#DCFCE7" BorderThickness="1.5"
                    ToolTip="Resumen de ingresos del día desglosados en efectivo y fiados por cobrar.">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08" Color="#059669" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Ventas de Hoy" FontSize="12" Foreground="#065F46" FontWeight="Bold" />
                    <TextBlock Text="{Binding VentasDelDiaTotal, StringFormat={}S/ {0:N2}}" FontSize="20" FontWeight="ExtraBold" Foreground="#059669" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <TextBlock Text="Efec: " FontSize="10" Foreground="#065F46" ToolTip="Ventas pagadas en efectivo hoy" />
                        <TextBlock Text="{Binding VentasEfectivoTotal, StringFormat={}S/ {0:N2}}" FontSize="10" FontWeight="Bold" Foreground="#065F46" />
                        <TextBlock Text=" | Fiado: " FontSize="10" Foreground="#065F46" Margin="4,0,0,0" ToolTip="Ventas otorgadas a crédito hoy" />
                        <TextBlock Text="{Binding VentasCreditoTotal, StringFormat={}S/ {0:N2}}" FontSize="10" FontWeight="Bold" Foreground="#B45309" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- KPI 4: Valorización Inventario & Botón Refresco -->
            <Border Grid.Column="6" Background="#F8FAF5" CornerRadius="8" Padding="12" BorderBrush="#DCE3D6" BorderThickness="1"
                    ToolTip="Valor económico total estimado de toda la mercadería almacenada.">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Valor de Inventario" FontSize="11" Foreground="#556049" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ValorTotalInventario, StringFormat={}S/ {0:N2}}" FontSize="14" FontWeight="Bold" Foreground="#354318" Margin="0,1,0,3" />
                        <Button Content="🔄 Actualizar" 
                                Command="{Binding CargarInventarioCommand}" 
                                FontSize="11" 
                                FontWeight="Bold" 
                                Padding="8,3" 
                                Background="#E8EEDF" 
                                Foreground="#354318" 
                                BorderBrush="#C5D1BC" 
                                BorderThickness="1" 
                                Cursor="Hand"
                                ToolTip="Recargar la lista de existencias." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- FILA 1: TABLA PRINCIPAL DE INVENTARIO -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#DCE3D6" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#1E2514" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cabecera de la tabla y filtro rápido -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Monitoreo de Existencias de Almacén" FontSize="16" FontWeight="Bold" Foreground="#1E2514" />
                        <TextBlock Text="Las filas destacadas en color rojo indican productos que requieren reposición urgente." FontSize="11" Foreground="#556049" Margin="0,1,0,0" />
                    </StackPanel>

                    <!-- Buscador en inventario -->
                    <Border Grid.Column="1" Background="#F8FAF5" CornerRadius="6" BorderBrush="#C5D1BC" BorderThickness="1" Width="240" Padding="6,2"
                            ToolTip="Escriba aquí para buscar productos en el almacén por nombre o código.">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" FontSize="12" Foreground="#4A5D23" />
                            <TextBox Grid.Column="1" 
                                     Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}" 
                                     FontSize="13" 
                                     Foreground="#1E2514" 
                                     BorderThickness="0" 
                                     Background="Transparent" 
                                     VerticalContentAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- DataGrid con Lógica Visual de Alerta -->
                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding Inventario}" 
                          SelectedItem="{Binding ProductoSeleccionado}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E8EEDF"
                          Background="#FFFFFF"
                          BorderBrush="#DCE3D6"
                          BorderThickness="1"
                          RowHeight="36"
                          FontSize="13">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsStockBajo}" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE" />
                                    <Setter Property="Foreground" Value="#B71C1C" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E8EEDF" />
                                    <Setter Property="Foreground" Value="#1E2514" />
                                    <Setter Property="BorderBrush" Value="#4A5D23" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80" FontWeight="Bold" />
                        <DataGridTextColumn Header="Nombre del Producto" Binding="{Binding Nombre}" Width="*" />
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="110" />
                        
                        <DataGridTemplateColumn Header="Stock Actual" Width="95" SortMemberPath="StockActual">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0" ToolTip="Cantidad disponible actualmente en almacén.">
                                        <TextBlock Text="{Binding StockActual, StringFormat={}{0:0.##}}" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="{Binding UnidadMedida, StringFormat={} {0}}" FontSize="11" Margin="3,0,0,0" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Stock Mín." Binding="{Binding StockMinimo, StringFormat={}{0:0.##}}" Width="85" />
                        <DataGridTextColumn Header="Capacidad Máx (CuMax)" Binding="{Binding CuMax, StringFormat={}{0:0.##}}" Width="140" />
                        <DataGridTextColumn Header="Precio Unit." Binding="{Binding PrecioUnitario, StringFormat={}S/ {0:N2}}" Width="95" FontWeight="Bold" />

                        <DataGridTemplateColumn Header="Estado / Alerta" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Background="#D32F2F" CornerRadius="10" Padding="8,2"
                                                Visibility="{Binding EsStockBajo, Converter={x:Static local:Converters.BooleanToVisibility}}"
                                                ToolTip="Alerta: Stock por debajo o igual al límite mínimo de seguridad.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠️" Margin="0,0,3,0" FontSize="10" />
                                                <TextBlock Text="STOCK BAJO" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" />
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#E8F5E9" CornerRadius="10" Padding="8,2"
                                                Visibility="{Binding EsStockBajo, Converter={x:Static local:Converters.InverseBooleanToVisibility}}"
                                                ToolTip="Stock adecuado disponible en almacén.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✓" Foreground="#2E7D32" FontWeight="Bold" Margin="0,0,3,0" FontSize="10" />
                                                <TextBlock Text="ABASTECIDO" Foreground="#2E7D32" FontWeight="Bold" FontSize="10" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- FILA 2: BANNER Y RESTRICCIÓN DE INGRESO DE STOCK POR LOTES FIFO -->
        <Border Grid.Row="2" Background="#F4F7EF" CornerRadius="8" BorderBrush="#C5D1BC" BorderThickness="1.5" Padding="14"
                ToolTip="Recordatorio de regla de inventario: Todos los nuevos ingresos de stock se deben registrar mediante lotes con proveedor y costo de compra.">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#4A5D23" CornerRadius="8" Width="42" Height="42">
                    <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Ingreso de Mercadería mediante Lotes de Compras" FontSize="14" FontWeight="Bold" Foreground="#1E2514" />
                    <TextBlock Text="Todo nuevo ingreso de mercadería debe registrarse como un nuevo lote con su costo de compra y proveedor en 'Lotes &amp; Vencimientos'." 
                               FontSize="11" Foreground="#556049" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="3" 
                        Content="📦 IR A LOTES &amp; VENCIMIENTOS" 
                        Command="{Binding NavegarALotesCommand}" 
                        FontSize="12" 
                        FontWeight="Bold" 
                        Padding="16,10" 
                        Background="#4A5D23" 
                        Foreground="#FFFFFF" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        VerticalAlignment="Center"
                        ToolTip="Ir al formulario para ingresar un nuevo lote de mercadería." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
