<UserControl x:Class="software_ACEMAR.Views.ProformasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:software_ACEMAR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- CABECERA Y FILTRO DE ESTADO -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Control de Proformas y Cotizaciones" FontSize="20" FontWeight="Bold" Foreground="#1E2514" />
                <TextBlock Text="Consulte cotizaciones vigentes o cárguelas de inmediato al mostrador para cobrar" FontSize="13" Foreground="#556049" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Filtrar por Estado:" FontSize="13" FontWeight="Bold" Foreground="#1E2514" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox SelectedValue="{Binding FiltroEstado}" 
                          SelectedValuePath="Content"
                          Height="36" Width="140" FontSize="13" VerticalContentAlignment="Center" Background="#FFFFFF">
                    <ComboBoxItem Content="Pendiente" IsSelected="True" />
                    <ComboBoxItem Content="Convertida" />
                    <ComboBoxItem Content="Anulada" />
                    <ComboBoxItem Content="Todas" />
                </ComboBox>

                <Button Content="🔄 Refrescar" 
                        Command="{Binding CargarProformasCommand}" 
                        Margin="8,0,0,0" 
                        Padding="12,8" 
                        FontSize="13" 
                        FontWeight="SemiBold" 
                        Background="#E8EEDF" 
                        Foreground="#354318" 
                        BorderBrush="#C5D1BC" 
                        BorderThickness="1" 
                        Cursor="Hand" />
            </StackPanel>
        </Grid>

        <!-- CONTENIDO PRINCIPAL: LISTA DE PROFORMAS Y DETALLE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="480" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2.5*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- TABLA DE PROFORMAS -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCE3D6" BorderThickness="1" Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="#1E2514" />
                </Border.Effect>

                <DataGrid ItemsSource="{Binding Proformas}" 
                          SelectedItem="{Binding ProformaSeleccionada}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF2E8"
                          Background="#FFFFFF"
                          BorderBrush="#DCE3D6"
                          BorderThickness="1"
                          RowHeight="44"
                          FontSize="14">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Número" Binding="{Binding NumeroProforma}" Width="150" FontWeight="Bold" />
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140" />
                        <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}S/ {0:N2}}" Width="110" FontWeight="Bold" />

                        <DataGridTemplateColumn Header="Estado" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFF9C4" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Estado}" Value="Convertida">
                                                        <Setter Property="Background" Value="#E8F5E9" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Estado}" Value="Anulada">
                                                        <Setter Property="Background" Value="#FFEBEE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding Estado}" FontWeight="Bold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#F57F17" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="Convertida">
                                                            <Setter Property="Foreground" Value="#2E7D32" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Estado}" Value="Anulada">
                                                            <Setter Property="Foreground" Value="#C62828" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- DETALLE DE LA PROFORMA SELECCIONADA -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCE3D6" BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="#1E2514" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Detalle de Cotización" FontSize="18" FontWeight="Bold" Foreground="#1E2514" />

                    <!-- Información de la Proforma -->
                    <Border Grid.Row="1" Background="#F8FAF5" CornerRadius="8" Padding="14" Margin="0,12,0,14" BorderBrush="#DCE3D6" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ProformaSeleccionada.NumeroProforma, FallbackValue='(Seleccione una proforma)'}" 
                                           FontSize="16" FontWeight="Bold" Foreground="#354318" />
                                <TextBlock Grid.Column="1" Text="{Binding ProformaSeleccionada.Estado, FallbackValue='-'}" 
                                           FontWeight="Bold" FontSize="13" Foreground="#4A5D23" />
                            </Grid>

                            <TextBlock Text="{Binding ProformaSeleccionada.ClienteNombre, FallbackValue='-', StringFormat={}Cliente: {0}}" 
                                       FontSize="14" Foreground="#1E2514" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ProformaSeleccionada.Fecha, FallbackValue='-', StringFormat={}Emitida: {0:dd/MM/yyyy HH:mm}}" 
                                       FontSize="12" Foreground="#556049" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Lista de Ítems -->
                    <DataGrid Grid.Row="2" 
                              ItemsSource="{Binding ProformaSeleccionada.Detalles}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False" 
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF2E8"
                              Background="#FFFFFF"
                              BorderBrush="#DCE3D6"
                              BorderThickness="1"
                              RowHeight="36"
                              FontSize="13" 
                              Margin="0,0,0,14">
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" Width="*" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, StringFormat={}{0:0.##}}" Width="65" />
                            <DataGridTextColumn Header="P. Unit." Binding="{Binding PrecioUnitario, StringFormat={}S/ {0:N2}}" Width="80" />
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat={}S/ {0:N2}}" Width="85" FontWeight="Bold" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Total -->
                    <Border Grid.Row="3" Background="#F4F7EF" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TOTAL COTIZADO:" FontSize="16" FontWeight="Bold" Foreground="#354318" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProformaSeleccionada.Total, FallbackValue='S/ 0.00', StringFormat={}S/ {0:N2}}" 
                                       FontSize="24" FontWeight="ExtraBold" Foreground="#4A5D23" />
                        </Grid>
                    </Border>

                    <!-- Botones de Acción -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="🛒 CONVERTIR A VENTA EN CAJA" 
                                Click="BtnConvertir_Click"
                                FontSize="14" 
                                FontWeight="Bold" 
                                Padding="14" 
                                Background="#4A5D23" 
                                Foreground="#FFFFFF" 
                                BorderThickness="0" 
                                Cursor="Hand" />

                        <Button Grid.Column="2" 
                                Content="❌ Anular" 
                                Command="{Binding AnularProformaCommand}" 
                                FontSize="13" 
                                FontWeight="SemiBold" 
                                Padding="14,10" 
                                Background="#FFF5F5" 
                                Foreground="#C62828" 
                                BorderBrush="#FFCDD2" 
                                BorderThickness="1" 
                                Cursor="Hand" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
