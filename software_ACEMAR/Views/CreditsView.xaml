<UserControl x:Class="software_ACEMAR.Views.CreditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:software_ACEMAR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <!-- VISTA BLOQUEADA SI TIENEACCESO == FALSE (REGLA CRE-01) -->
        <Border Background="#FFF8F8" 
                CornerRadius="12" 
                BorderBrush="#FFCDD2" 
                BorderThickness="2" 
                Padding="40" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                MaxWidth="600"
                Visibility="{Binding TieneAcceso, Converter={x:Static local:Converters.InverseBooleanToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🔒" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <TextBlock Text="Acceso Restringido" FontSize="24" FontWeight="Bold" Foreground="#B71C1C" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding MensajePermisoVendedor, FallbackValue='Permisos insuficientes. Contacte al Administrador'}" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="#556049" 
                           TextAlignment="Center" 
                           Margin="0,12,0,0" 
                           TextWrapping="Wrap" />
                <TextBlock Text="Por políticas de control interno de Ferretería ACEMAR (Regla CRE-01), el personal con rol 'Vendedor' no tiene autorización para consultar deudas ni registrar abonos." 
                           FontSize="13" 
                           Foreground="#78909C" 
                           TextAlignment="Center" 
                           Margin="0,10,0,0" 
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- VISTA PRINCIPAL AUTORIZADA (ADMINISTRADOR) -->
        <Grid Visibility="{Binding TieneAcceso, Converter={x:Static local:Converters.BooleanToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- FILA 0: TARJETAS KPI DE CARTERA DE CRÉDITO -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Cartera Total Pendiente -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="16" BorderBrush="#DCE3D6" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06" Color="#1E2514" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Total Cartera por Cobrar" FontSize="13" Foreground="#556049" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalDeudaPorCobrar, StringFormat={}S/ {0:N2}}" FontSize="30" FontWeight="ExtraBold" Foreground="#D32F2F" Margin="0,4,0,0" />
                        <TextBlock Text="Saldo global pendiente de pago" FontSize="12" Foreground="#889876" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- KPI 2: Clientes con Deuda -->
                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" Padding="16" BorderBrush="#DCE3D6" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06" Color="#1E2514" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Clientes con Deuda Activa" FontSize="13" Foreground="#556049" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalClientesConDeuda}" FontSize="30" FontWeight="ExtraBold" Foreground="#354318" Margin="0,4,0,0" />
                        <TextBlock Text="Cuentas corrientes registradas" FontSize="12" Foreground="#889876" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tarjeta de Políticas de Fiados -->
                <Border Grid.Column="4" Background="#F8FAF5" CornerRadius="10" Padding="16" BorderBrush="#DCE3D6" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️ " FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Política de Créditos y Fiados ACEMAR" FontSize="13" FontWeight="Bold" Foreground="#354318" />
                        </StackPanel>
                        <TextBlock Text="Los abonos reducen la deuda de forma matemática e inmediata en la base de datos local SQLite. No se admiten abonos mayores a la deuda pendiente." 
                                   FontSize="12" Foreground="#556049" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- FILA 1: TABLA DE CLIENTES Y FORMULARIO DE ABONO -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="480" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- PANEL IZQUIERDO: LISTA DE CLIENTES CON DEUDA -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCE3D6" BorderThickness="1" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="#1E2514" />
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Encabezado de Lista -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cuentas Corrientes y Fiados" FontSize="20" FontWeight="Bold" Foreground="#1E2514" />
                                <TextBlock Text="Seleccione un cliente para ver su saldo y registrar un abono" FontSize="13" Foreground="#556049" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" 
                                    Content="🔄 Refrescar" 
                                    Command="{Binding RecargarCommand}" 
                                    FontSize="12" 
                                    FontWeight="SemiBold"
                                    Background="#E8EEDF" 
                                    Foreground="#354318" 
                                    BorderBrush="#C5D1BC" 
                                    BorderThickness="1" 
                                    Padding="12,6" 
                                    Cursor="Hand" />
                        </Grid>

                        <!-- DataGrid de Clientes -->
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding ClientesDeuda}" 
                                  SelectedItem="{Binding ClienteSeleccionado}"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEF2E8"
                                  Background="#FFFFFF"
                                  BorderBrush="#DCE3D6"
                                  BorderThickness="1"
                                  RowHeight="46"
                                  FontSize="14">
                            
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Cliente / Empresa" Width="*" SortMemberPath="Nombre">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="6,2">
                                                <TextBlock Text="{Binding Nombre}" FontWeight="Bold" Foreground="#1E2514" FontSize="14" />
                                                <TextBlock Text="{Binding Documento, StringFormat={}Doc: {0}}" FontSize="11" Foreground="#667554" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="110" />

                                <DataGridTemplateColumn Header="Deuda Pendiente" Width="130" SortMemberPath="DeudaActual">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DeudaActual, StringFormat={}S/ {0:N2}}" 
                                                       FontWeight="Bold" 
                                                       FontSize="15" 
                                                       Foreground="#D32F2F" 
                                                       VerticalAlignment="Center" 
                                                       Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Límite Crédito" Binding="{Binding LimiteCredito, StringFormat={}S/ {0:N2}}" Width="115" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- PANEL DERECHO: GESTIÓN DE FIADOS, ABONOS Y CLIENTES -->
                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCE3D6" BorderThickness="1" Padding="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="#1E2514" />
                    </Border.Effect>

                    <TabControl Background="Transparent" BorderThickness="0">
                        <!-- PESTAÑA 1: REGISTRAR ABONO -->
                        <TabItem Header="💰 Registrar Abono" FontSize="13" FontWeight="Bold" Padding="12,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Registrar Abono a Cuenta" FontSize="17" FontWeight="Bold" Foreground="#1E2514" />
                                    <TextBlock Text="Resta inmediata de la deuda en la base de datos local" FontSize="12" Foreground="#556049" Margin="0,2,0,12" />

                                    <!-- Resumen Cliente Seleccionado -->
                                    <Border Background="#F8FAF5" CornerRadius="8" Padding="12" BorderBrush="#DCE3D6" BorderThickness="1" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Cliente Seleccionado:" FontSize="12" Foreground="#556049" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ClienteSeleccionado.Nombre, FallbackValue='(Seleccione un cliente de la lista a la izquierda)'}" 
                                                       FontSize="15" FontWeight="Bold" Foreground="#354318" Margin="0,2,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Deuda Pendiente:" FontSize="11" Foreground="#556049" />
                                                    <TextBlock Text="{Binding ClienteSeleccionado.DeudaActual, FallbackValue='S/ 0.00', StringFormat={}S/ {0:N2}}" 
                                                               FontSize="17" FontWeight="ExtraBold" Foreground="#D32F2F" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Disponible:" FontSize="11" Foreground="#556049" />
                                                    <TextBlock Text="{Binding ClienteSeleccionado.CreditoDisponible, FallbackValue='S/ 0.00', StringFormat={}S/ {0:N2}}" 
                                                               FontSize="16" FontWeight="Bold" Foreground="#4A5D23" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Monto -->
                                    <TextBlock Text="Monto a Abonar (S/):" FontSize="14" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding MontoAbonoTexto, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="20" FontWeight="Bold" Foreground="#4A5D23" Padding="8,4" Background="#FFFFFF" Margin="0,0,0,12" />

                                    <!-- Observación -->
                                    <TextBlock Text="Observaciones / Recibo:" FontSize="13" FontWeight="SemiBold" Foreground="#1E2514" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ObservacionAbono, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="13" Padding="8" Background="#F8FAF5" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14" />

                                    <!-- Botón Confirmar Abono -->
                                    <Button Content="💰 CONFIRMAR ABONO" 
                                            Command="{Binding RegistrarAbonoCommand}" 
                                            FontSize="15" FontWeight="Bold" Padding="14" 
                                            Background="#4A5D23" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- PESTAÑA 2: OTORGAR NUEVO FIADO -->
                        <TabItem Header="📝 Nuevo Fiado" FontSize="13" FontWeight="Bold" Padding="12,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Otorgar Nuevo Fiado Directo" FontSize="17" FontWeight="Bold" Foreground="#1E2514" />
                                    <TextBlock Text="Asigna una nueva cuenta por cobrar verificando el límite aprobado" FontSize="12" Foreground="#556049" Margin="0,2,0,12" />

                                    <!-- Resumen Cliente -->
                                    <Border Background="#F8FAF5" CornerRadius="8" Padding="12" BorderBrush="#DCE3D6" BorderThickness="1" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Cliente Seleccionado:" FontSize="12" Foreground="#556049" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ClienteSeleccionado.Nombre, FallbackValue='(Seleccione un cliente de la lista)'}" 
                                                       FontSize="15" FontWeight="Bold" Foreground="#354318" Margin="0,2,0,6" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Límite: " FontSize="12" Foreground="#556049" />
                                                <TextBlock Text="{Binding ClienteSeleccionado.LimiteCredito, FallbackValue='S/ 0.00', StringFormat={}S/ {0:N2}}" FontWeight="Bold" FontSize="12" />
                                                <TextBlock Text=" | Disponible: " FontSize="12" Foreground="#556049" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding ClienteSeleccionado.CreditoDisponible, FallbackValue='S/ 0.00', StringFormat={}S/ {0:N2}}" FontWeight="Bold" FontSize="12" Foreground="#2E7D32" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Monto Fiado -->
                                    <TextBlock Text="Monto del Nuevo Fiado (S/):" FontSize="14" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding MontoNuevoFiado, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="20" FontWeight="Bold" Foreground="#D32F2F" Padding="8,4" Background="#FFFFFF" Margin="0,0,0,12" />

                                    <!-- Detalle -->
                                    <TextBlock Text="Detalle / Motivo del Crédito:" FontSize="13" FontWeight="SemiBold" Foreground="#1E2514" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding DetalleNuevoFiado, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="13" Padding="8" Background="#F8FAF5" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14" />

                                    <!-- Botón Confirmar Fiado -->
                                    <Button Content="📝 ASIGNAR NUEVO FIADO" 
                                            Command="{Binding RegistrarNuevoFiadoCommand}" 
                                            FontSize="15" FontWeight="Bold" Padding="14" 
                                            Background="#D32F2F" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- PESTAÑA 3: REGISTRAR NUEVO CLIENTE -->
                        <TabItem Header="➕ Nuevo Cliente" FontSize="13" FontWeight="Bold" Padding="12,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Registrar Nuevo Cliente Fiado" FontSize="17" FontWeight="Bold" Foreground="#1E2514" />
                                    <TextBlock Text="Alta en el sistema de cuentas corrientes y crédito ferretero" FontSize="12" Foreground="#556049" Margin="0,2,0,12" />

                                    <!-- Nombre -->
                                    <TextBlock Text="Nombre o Razón Social:" FontSize="13" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NuevoClienteNombre, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="14" Padding="8,6" Background="#F8FAF5" Margin="0,0,0,10" />

                                    <!-- Documento DNI / RUC -->
                                    <TextBlock Text="Documento (DNI o RUC):" FontSize="13" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NuevoClienteDocumento, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="14" Padding="8,6" Background="#F8FAF5" Margin="0,0,0,10" />

                                    <!-- Teléfono -->
                                    <TextBlock Text="Teléfono de Contacto:" FontSize="13" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NuevoClienteTelefono, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="14" Padding="8,6" Background="#F8FAF5" Margin="0,0,0,10" />

                                    <!-- Límite de Crédito -->
                                    <TextBlock Text="Límite de Crédito Aprobado (S/):" FontSize="13" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding NuevoClienteLimite, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="16" FontWeight="Bold" Foreground="#4A5D23" Padding="8,6" Background="#F8FAF5" Margin="0,0,0,16" />

                                    <!-- Botón Guardar Cliente -->
                                    <Button Content="➕ GUARDAR NUEVO CLIENTE" 
                                            Command="{Binding RegistrarNuevoClienteCommand}" 
                                            FontSize="15" FontWeight="Bold" Padding="14" 
                                            Background="#4A5D23" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
