<UserControl x:Class="software_ACEMAR.Views.CashRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:software_ACEMAR.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Fila 0: Barra de Control y Selección de Fecha -->
            <RowDefinition Height="Auto" />
            <!-- Fila 1: Tarjetas KPI de Balance de Caja -->
            <RowDefinition Height="Auto" />
            <!-- Fila 2: Tabla de Movimientos y Cierre -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- FILA 0: CONTROL DE FECHA Y APERTURA -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" Padding="16" BorderBrush="#DCE3D6" BorderThickness="1" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06" Color="#1E2514" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Arqueo y Cierre de Caja Diario" FontSize="20" FontWeight="Bold" Foreground="#1E2514" />
                    <TextBlock Text="Auditoría de ingresos físicos en mostrador vs. cuentas de fiados otorgados" FontSize="12" Foreground="#556049" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Selector de Fecha -->
                <TextBlock Grid.Column="1" Text="Fecha a Auditar:" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1E2514" Margin="0,0,8,0" />
                <DatePicker Grid.Column="2" SelectedDate="{Binding FechaSeleccionada}" Height="36" FontSize="13" VerticalContentAlignment="Center" />

                <!-- Monto Apertura -->
                <TextBlock Grid.Column="4" Text="Fondo Apertura (S/):" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1E2514" Margin="0,0,8,0" />
                <TextBox Grid.Column="5" 
                         Text="{Binding MontoApertura, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.00}}" 
                         Height="36" 
                         FontSize="15" 
                         FontWeight="Bold" 
                         VerticalContentAlignment="Center" 
                         HorizontalContentAlignment="Center" 
                         Background="#F8FAF5" 
                         BorderBrush="#4A5D23" 
                         BorderThickness="1.5" />

                <!-- Botón Actualizar -->
                <Button Grid.Column="7" 
                        Content="🔄 RECALCULAR" 
                        Command="{Binding CalcularArqueoCommand}" 
                        Height="36" 
                        Padding="16,0" 
                        FontSize="13" 
                        FontWeight="Bold" 
                        Background="#4A5D23" 
                        Foreground="#FFFFFF" 
                        Cursor="Hand" />
            </Grid>
        </Border>

        <!-- FILA 1: TARJETAS KPI DE FLUJO DE CAJA -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Ventas Efectivo -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="14" BorderBrush="#DCE3D6" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="💵 Ventas en Efectivo" FontSize="12" Foreground="#556049" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalVentasEfectivo, StringFormat={}S/ {0:N2}}" FontSize="24" FontWeight="ExtraBold" Foreground="#2E7D32" Margin="0,4,0,0" />
                    <TextBlock Text="Dinero recibido en mano" FontSize="11" Foreground="#889876" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- KPI 2: Ventas Crédito / Fiados -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" Padding="14" BorderBrush="#DCE3D6" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="💳 Ventas a Crédito (Fiados)" FontSize="12" Foreground="#556049" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalVentasCredito, StringFormat={}S/ {0:N2}}" FontSize="24" FontWeight="ExtraBold" Foreground="#D32F2F" Margin="0,4,0,0" />
                    <TextBlock Text="Cuentas por cobrar generadas" FontSize="11" Foreground="#889876" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- KPI 3: Abonos Cobrados -->
            <Border Grid.Column="4" Background="#FFFFFF" CornerRadius="10" Padding="14" BorderBrush="#DCE3D6" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📥 Abonos Cobrados" FontSize="12" Foreground="#556049" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalAbonosEfectivo, StringFormat={}S/ {0:N2}}" FontSize="24" FontWeight="ExtraBold" Foreground="#1976D2" Margin="0,4,0,0" />
                    <TextBlock Text="Cobranza de deudas previas" FontSize="11" Foreground="#889876" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- KPI 4: Total Efectivo en Caja (Destacado en Verde Militar) -->
            <Border Grid.Column="6" Background="#E8EEDF" CornerRadius="10" Padding="14" BorderBrush="#4A5D23" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="💰 TOTAL EFECTIVO EN CAJA" FontSize="12" Foreground="#354318" FontWeight="ExtraBold" />
                    <TextBlock Text="{Binding TotalEfectivoEnCaja, StringFormat={}S/ {0:N2}}" FontSize="26" FontWeight="ExtraBold" Foreground="#4A5D23" Margin="0,4,0,0" />
                    <TextBlock Text="Apertura + Ventas Efectivo + Abonos" FontSize="11" Foreground="#556049" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- FILA 2: MOVIMIENTOS DETALLADOS Y FORMULARIO DE CIERRE -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="480" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- LISTA DE MOVIMIENTOS -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCE3D6" BorderThickness="1" Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="#1E2514" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Detalle Cronológico de Movimientos" FontSize="17" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,12" />

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Movimientos}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False" 
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF2E8"
                              Background="#FFFFFF"
                              BorderBrush="#DCE3D6"
                              BorderThickness="1"
                              RowHeight="40"
                              FontSize="13">
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hora" Binding="{Binding FechaHora, StringFormat={}{0:HH:mm}}" Width="65" />
                            <DataGridTextColumn Header="Tipo de Movimiento" Binding="{Binding Tipo}" Width="180" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Documento" Binding="{Binding Documento}" Width="130" />
                            <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" Width="*" />
                            <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat={}S/ {0:N2}}" Width="95" FontWeight="Bold" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- PANEL DE CIERRE DE CAJA -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCE3D6" BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="#1E2514" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Cierre y Cuadre de Caja" FontSize="18" FontWeight="Bold" Foreground="#1E2514" />
                    <TextBlock Text="Registre formalmente el saldo al terminar la jornada de mostrador" FontSize="12" Foreground="#556049" Margin="0,2,0,16" />

                    <!-- Resumen rápido -->
                    <Border Background="#F8FAF5" CornerRadius="8" Padding="14" BorderBrush="#DCE3D6" BorderThickness="1" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Total Dinero Físico:" FontSize="13" Foreground="#556049" />
                                <TextBlock Text="{Binding TotalEfectivoEnCaja, StringFormat={}S/ {0:N2}}" FontWeight="Bold" FontSize="14" Foreground="#4A5D23" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Total Cuentas Fiadas:" FontSize="13" Foreground="#556049" />
                                <TextBlock Text="{Binding TotalVentasCredito, StringFormat={}S/ {0:N2}}" FontWeight="Bold" FontSize="14" Foreground="#D32F2F" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Abonos Ingresados:" FontSize="13" Foreground="#556049" />
                                <TextBlock Text="{Binding TotalAbonosEfectivo, StringFormat={}S/ {0:N2}}" FontWeight="Bold" FontSize="14" Foreground="#1976D2" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Observaciones de Cierre -->
                    <TextBlock Text="Observaciones / Novedades del Día:" FontSize="13" FontWeight="Bold" Foreground="#1E2514" Margin="0,0,0,6" />
                    <TextBox Text="{Binding ObservacionesCierre, UpdateSourceTrigger=PropertyChanged}" 
                             Height="100" 
                             FontSize="13" 
                             Padding="8" 
                             Background="#F8FAF5" 
                             BorderBrush="#C5D1BC" 
                             BorderThickness="1" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             VerticalContentAlignment="Top" 
                             Margin="0,0,0,16" />

                    <!-- Botón Guardar Arqueo -->
                    <Button Content="📋 REGISTRAR Y GUARDAR ARQUEO" 
                            Command="{Binding GuardarArqueoCommand}" 
                            FontSize="14" 
                            FontWeight="Bold" 
                            Padding="16,14" 
                            Background="#4A5D23" 
                            Foreground="#FFFFFF" 
                            BorderThickness="0" 
                            Cursor="Hand" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
