<Window x:Class="software_ACEMAR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:software_ACEMAR"
        xmlns:vm="clr-namespace:software_ACEMAR.ViewModels"
        xmlns:views="clr-namespace:software_ACEMAR.Views"
        mc:Ignorable="d"
        Title="Ferretería ACEMAR - Sistema Integrado de Control, Inventario por Lotes y Punto de Venta" 
        Height="740" Width="1280"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F0"
        AutomationProperties.Name="Ventana Principal Ferretería ACEMAR"
        AutomationProperties.HelpText="Sistema de gestión integral para punto de venta, inventario FIFO por lotes, crédito, proveedores y auditoría de ventas">



    <Window.Resources>
        <!-- Converters para navegación y visibilidad -->
        <views:ActiveTabBackgroundConverter x:Key="ActiveBgConv" />
        <views:ActiveTabBorderConverter x:Key="ActiveBorderConv" />
        <views:ActiveTabForegroundConverter x:Key="ActiveFgConv" />
        <views:ActiveTabIconForegroundConverter x:Key="ActiveIconFgConv" />

        <!-- DataTemplates implícitos para ViewModels -->
        <DataTemplate DataType="{x:Type vm:DashboardGeneralViewModel}">
            <views:DashboardGeneralView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductCrudViewModel}">
            <views:ProductCrudView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreditsViewModel}">
            <views:CreditsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProformasViewModel}">
            <views:ProformasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CashRegisterViewModel}">
            <views:CashRegisterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LotesViewModel}">
            <views:LotesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProveedoresViewModel}">
            <views:ProveedoresView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VentasCorreccionViewModel}">
            <views:VentasCorreccionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsuariosViewModel}">
            <views:UsuariosView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Menú Lateral Oscuro Adaptable (Verde Militar #1D2611) -->
            <ColumnDefinition Width="250" />
            <!-- Contenedor Principal de Vistas -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- MENÚ LATERAL IZQUIERDO - ADAPTABLE Y RESPONSIVO (#1D2611)       -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Background="#1D2611" BorderBrush="#141B0B" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Cabecera Marca ACEMAR -->
                    <RowDefinition Height="Auto" />
                    <!-- Separador Estético -->
                    <RowDefinition Height="Auto" />
                    <!-- Botones de Navegación con ScrollViewer Adaptable -->
                    <RowDefinition Height="*" />
                    <!-- Panel de Seguridad / Usuario Activo -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. BRANDING ACEMAR & ICONO VERDE BD CONECTADA -->
                <Border Grid.Row="0" Background="#151C0C" Padding="16,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#4A5D23" Width="38" Height="38" CornerRadius="10" 
                                BorderBrush="#8FA668" BorderThickness="1.5">
                            <TextBlock Text="🛠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ACEMAR" FontSize="19" FontWeight="Black" Foreground="#FFFFFF" />
                            <TextBlock Text="FERRETERÍA &amp; ALMACÉN" FontSize="10" FontWeight="Bold" Foreground="#BCE08A" Margin="0,1,0,0" />
                        </StackPanel>

                        <!-- Indicador Punto Verde BD Local Activa -->
                        <Ellipse Grid.Column="2" Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center" Margin="6,0,0,0"
                                 ToolTip="Base de Datos SQLite Local Activa &amp; Operativa" />
                    </Grid>
                </Border>

                <Separator Grid.Row="1" Background="#354318" Height="1" Margin="0" />

                <!-- 2. BOTONES DE NAVEGACIÓN MODULAR -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="ESTADÍSTICAS Y PANEL GENERAL" FontSize="9" FontWeight="ExtraBold" Foreground="#A9BF88" Margin="8,0,0,6" />

                        <!-- 0. Dashboard General -->
                        <Button Command="{Binding NavegarDashboardGeneralCommand}" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,0,0,8" FontSize="12" FontWeight="Bold"
                                Background="{Binding IsDashboardGeneralActive, Converter={StaticResource ActiveBgConv}}" Foreground="{Binding IsDashboardGeneralActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsDashboardGeneralActive, Converter={StaticResource ActiveBorderConv}}" BorderThickness="1.5" ToolTip="Dashboard Analítico, Gráficos &amp; Accesos Directos">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📊" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding IsDashboardGeneralActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Dashboard Analítico" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding IsDashboardGeneralActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="4" Height="14" Background="#A4C868" CornerRadius="2" Visibility="{Binding IsDashboardGeneralActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <TextBlock Text="OPERACIONES Y MOSTRADOR" FontSize="9" FontWeight="ExtraBold" Foreground="#A9BF88" Margin="8,4,0,6" />

                        <!-- 1. Punto de Venta (POS) -->
                        <Button Command="{Binding NavegarPosCommand}" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,0,0,4" FontSize="12" FontWeight="Bold"
                                Background="{Binding IsPosActive, Converter={StaticResource ActiveBgConv}}" Foreground="{Binding IsPosActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsPosActive, Converter={StaticResource ActiveBorderConv}}" BorderThickness="1.5" ToolTip="Punto de Venta (POS) - Despacho Multimedida &amp; FIFO">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🛒" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding IsPosActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Punto de Venta (POS)" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding IsPosActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="4" Height="14" Background="#A4C868" CornerRadius="2" Visibility="{Binding IsPosActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <!-- 2. Inventario Inteligente (Dashboard) -->
                        <Button Command="{Binding NavegarDashboardCommand}" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,0,0,4" FontSize="12" FontWeight="Bold"
                                Background="{Binding IsDashboardActive, Converter={StaticResource ActiveBgConv}}" Foreground="{Binding IsDashboardActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsDashboardActive, Converter={StaticResource ActiveBorderConv}}" BorderThickness="1.5" ToolTip="Inventario &amp; CuMax Almacén">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📦" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding IsDashboardActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Inventario &amp; Almacén" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding IsDashboardActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="4" Height="14" Background="#A4C868" CornerRadius="2" Visibility="{Binding IsDashboardActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <!-- 3. Lotes & FIFO -->
                        <Button Command="{Binding NavegarLotesCommand}" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,0,0,4" FontSize="12" FontWeight="Bold"
                                Background="{Binding IsLotesActive, Converter={StaticResource ActiveBgConv}}" Foreground="{Binding IsLotesActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsLotesActive, Converter={StaticResource ActiveBorderConv}}" BorderThickness="1.5" ToolTip="Gestión de Lotes y Vencimientos FIFO">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📦" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding IsLotesActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Lotes &amp; Vencimientos" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding IsLotesActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="4" Height="14" Background="#A4C868" CornerRadius="2" Visibility="{Binding IsLotesActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <!-- 4. Catálogo y Precios (CRUD) -->
                        <Button Command="{Binding NavegarProductCrudCommand}" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,0,0,4" FontSize="12" FontWeight="Bold"
                                Background="{Binding IsProductCrudActive, Converter={StaticResource ActiveBgConv}}" Foreground="{Binding IsProductCrudActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsProductCrudActive, Converter={StaticResource ActiveBorderConv}}" BorderThickness="1.5" ToolTip="Catálogo de Productos y Precios Masivos">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🏷️" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding IsProductCrudActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Catálogo &amp; Precios" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding IsProductCrudActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="4" Height="14" Background="#A4C868" CornerRadius="2" Visibility="{Binding IsProductCrudActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <!-- 5. Proveedores -->
                        <Button Command="{Binding NavegarProveedoresCommand}" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,0,0,4" FontSize="12" FontWeight="Bold"
                                Background="{Binding IsProveedoresActive, Converter={StaticResource ActiveBgConv}}" Foreground="{Binding IsProveedoresActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsProveedoresActive, Converter={StaticResource ActiveBorderConv}}" BorderThickness="1.5" ToolTip="Directorio y Tiempos de Reposición de Proveedores">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🏭" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding IsProveedoresActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Proveedores" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding IsProveedoresActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="4" Height="14" Background="#A4C868" CornerRadius="2" Visibility="{Binding IsProveedoresActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <TextBlock Text="FINANZAS Y CONTROL AUDITADO" FontSize="9" FontWeight="ExtraBold" Foreground="#A9BF88" Margin="8,8,0,6" />

                        <!-- 6. Créditos y Fiados -->
                        <Button Command="{Binding NavegarCreditsCommand}" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,0,0,4" FontSize="12" FontWeight="Bold"
                                Background="{Binding IsCreditsActive, Converter={StaticResource ActiveBgConv}}" Foreground="{Binding IsCreditsActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsCreditsActive, Converter={StaticResource ActiveBorderConv}}" BorderThickness="1.5" ToolTip="Gestión de Créditos y Cuentas por Cobrar">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="💳" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding IsCreditsActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Créditos &amp; Fiados" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding IsCreditsActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="4" Height="14" Background="#A4C868" CornerRadius="2" Visibility="{Binding IsCreditsActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <!-- 7. Proformas -->
                        <Button Command="{Binding NavegarProformasCommand}" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,0,0,4" FontSize="12" FontWeight="Bold"
                                Background="{Binding IsProformasActive, Converter={StaticResource ActiveBgConv}}" Foreground="{Binding IsProformasActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsProformasActive, Converter={StaticResource ActiveBorderConv}}" BorderThickness="1.5" ToolTip="Proformas y Cotizaciones Comerciales">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📋" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding IsProformasActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Proformas" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding IsProformasActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="4" Height="14" Background="#A4C868" CornerRadius="2" Visibility="{Binding IsProformasActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <!-- 8. Arqueo de Caja -->
                        <Button Command="{Binding NavegarCashRegisterCommand}" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,0,0,4" FontSize="12" FontWeight="Bold"
                                Background="{Binding IsCashRegisterActive, Converter={StaticResource ActiveBgConv}}" Foreground="{Binding IsCashRegisterActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsCashRegisterActive, Converter={StaticResource ActiveBorderConv}}" BorderThickness="1.5" ToolTip="Arqueo y Cierre Diario de Caja">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="💵" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding IsCashRegisterActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Arqueo de Caja" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding IsCashRegisterActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="4" Height="14" Background="#A4C868" CornerRadius="2" Visibility="{Binding IsCashRegisterActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <!-- 9. Corrección / Auditoría de Ventas -->
                        <Button Command="{Binding NavegarVentasCorreccionCommand}" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,0,0,4" FontSize="12" FontWeight="Bold"
                                Background="{Binding IsVentasCorreccionActive, Converter={StaticResource ActiveBgConv}}" Foreground="{Binding IsVentasCorreccionActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsVentasCorreccionActive, Converter={StaticResource ActiveBorderConv}}" BorderThickness="1.5" ToolTip="Auditoría y Corrección de Ventas Emitidas">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🛡️" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding IsVentasCorreccionActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Auditoría de Ventas" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding IsVentasCorreccionActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="4" Height="14" Background="#A4C868" CornerRadius="2" Visibility="{Binding IsVentasCorreccionActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <TextBlock Text="CONFIGURACIÓN Y SEGURIDAD" FontSize="9" FontWeight="ExtraBold" Foreground="#A9BF88" Margin="8,8,0,6" />

                        <!-- 10. Gestión de Usuarios y Vendedores (Panel Admin) -->
                        <Button Command="{Binding NavegarUsuariosCommand}" HorizontalContentAlignment="Left" Padding="8,8" Margin="0,0,0,4" FontSize="12" FontWeight="Bold"
                                Background="{Binding IsUsuariosActive, Converter={StaticResource ActiveBgConv}}" Foreground="{Binding IsUsuariosActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsUsuariosActive, Converter={StaticResource ActiveBorderConv}}" BorderThickness="1.5" ToolTip="Gestión de Usuarios, Permisos y Vendedores (Exclusivo Administrador)">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="👥" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding IsUsuariosActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Gestión de Usuarios" VerticalAlignment="Center" FontWeight="Bold" Foreground="{Binding IsUsuariosActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="4" Height="14" Background="#A4C868" CornerRadius="2" Visibility="{Binding IsUsuariosActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. PERFIL DE USUARIO Y ESTADO DE SESIÓN -->
                <Border Grid.Row="3" Background="#151C0C" Padding="12,10" Margin="8,0,8,8" CornerRadius="8"
                        BorderBrush="#2D3B16" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2E3B15" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center" BorderBrush="#8FA668" BorderThickness="1">
                            <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NombreUsuarioActual}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                            <TextBlock Text="Sesión Activa • Operador" FontSize="9" Foreground="#98AF7A" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ÁREA PRINCIPAL DERECHA - ENTORNO DE TRABAJO Y BARRA SUPERIOR   -->
        <!-- ============================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Barra Superior con Título y Estado -->
                <RowDefinition Height="55" />
                <!-- ContentControl con Vista Activa en Card Container Adaptable -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR DE LA APLICACIÓN -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DCDEC8" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Título dinámico de la Vista Actual -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TituloVistaActual}" FontSize="18" FontWeight="Black" Foreground="#1E2514" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Botón Interactivo de Cambio de Rol y Estación de Trabajo -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding AlternarModoAdminCommand}"
                                Padding="12,6" Margin="0,0,10,0"
                                Cursor="Hand" ToolTip="Haga clic aquí para Cambiar de Rol (Administrador / Vendedor)">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#EAF0E1" />
                                    <Setter Property="BorderBrush" Value="#B5C6A0" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🔑 Rol: " FontSize="11" Foreground="#354318" FontWeight="Medium" />
                                                        <TextBlock Text="{Binding RolActual}" FontWeight="ExtraBold" FontSize="11" Foreground="#1E2514" />
                                                        <TextBlock Text=" ⚙️" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#4A5D23" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#DCE8CF" />
                                                        <Setter Property="BorderBrush" Value="#4A5D23" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Botón Cerrar Sesión -->
                        <Button Command="{Binding CerrarSesionCommand}"
                                Padding="10,6" Margin="0,0,10,0"
                                Background="#FFEBEE" Foreground="#C62828" BorderBrush="#FFCDD2" BorderThickness="1"
                                Cursor="Hand" ToolTip="Cerrar sesión activa y volver a la pantalla de inicio de sesión">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚪 Cerrar Sesión" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <Border Background="#F4F6F0" CornerRadius="8" Padding="8,5" BorderBrush="#DCDEC8" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MostradorActual, StringFormat={}🖥️ {0}}" FontSize="11" FontWeight="Bold" Foreground="#4A5D23" ToolTip="Mostrador / Estación asignada al usuario actual" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================== -->
            <!-- CARD CONTAINER RESPONSIVO PARA VISTAS (BOUNDED DESKTOP VIEW)   -->
            <!-- ============================================================== -->
            <Grid Grid.Row="1" Margin="10">
                <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCDEC8" BorderThickness="1" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#1E2514" Opacity="0.05" />
                    </Border.Effect>

                    <ContentControl Content="{Binding CurrentViewModel}" Background="Transparent" Focusable="True" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
