<Window x:Class="software_ACEMAR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:software_ACEMAR"
        xmlns:vm="clr-namespace:software_ACEMAR.ViewModels"
        xmlns:views="clr-namespace:software_ACEMAR.Views"
        mc:Ignorable="d"
        Title="Ferretería ACEMAR - Sistema Integrado de Control y Punto de Venta" 
        Height="720" Width="1240"
        MinHeight="540" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F0"
        AutomationProperties.Name="Ventana Principal Ferretería ACEMAR"
        AutomationProperties.HelpText="Sistema de gestión integral para punto de venta, inventario, créditos y arqueo de caja">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Converters para navegación y visibilidad -->
        <views:ActiveTabBackgroundConverter x:Key="ActiveBgConv" />
        <views:ActiveTabBorderConverter x:Key="ActiveBorderConv" />
        <views:ActiveTabForegroundConverter x:Key="ActiveFgConv" />
        <views:ActiveTabIconForegroundConverter x:Key="ActiveIconFgConv" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Menú Lateral Oscuro Adaptable (Verde Militar #1D2611) -->
            <ColumnDefinition Width="250" />
            <!-- Contenedor Principal de Vistas -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- MENÚ LATERAL IZQUIERDO - ADAPTABLE Y RESPONSIVO (#1D2611)       -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Background="#1D2611" BorderBrush="#141B0B" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Cabecera Marca ACEMAR -->
                    <RowDefinition Height="Auto" />
                    <!-- Separador Estético -->
                    <RowDefinition Height="Auto" />
                    <!-- Botones de Navegación con ScrollViewer Adaptable -->
                    <RowDefinition Height="*" />
                    <!-- Panel de Seguridad / Usuario Activo -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. BRANDING ACEMAR & ESTADO BD LOCAL -->
                <Border Grid.Row="0" Background="#151C0C" Padding="16,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#4A5D23" Width="40" Height="40" CornerRadius="10" 
                                    BorderBrush="#8FA668" BorderThickness="1.5">
                                <TextBlock Text="🛠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ACEMAR" FontSize="20" FontWeight="Black" Foreground="#FFFFFF" />
                                <TextBlock Text="FERRETERÍA &amp; ALMACÉN" FontSize="10" FontWeight="Bold" Foreground="#BCE08A" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Indicador Accesible de Base de Datos Local SQLite -->
                        <Border Background="#0E1408" CornerRadius="8" Padding="10,6" Margin="0,14,0,0"
                                BorderBrush="#2D3B16" BorderThickness="1"
                                AutomationProperties.Name="Estado de la base de datos local SQLite activa"
                                ToolTip="Base de datos SQLite local conectada y funcionando en modo fuera de línea.">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="BD Local SQLite: Conectada" FontSize="11" FontWeight="Bold" Foreground="#E2EAD8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Separator Grid.Row="1" Background="#354318" Height="1" Margin="0" />

                <!-- 2. BOTONES DE NAVEGACIÓN MODULAR (MVVM CON ESTADO ACTIVO DINÁMICO) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="10,12,10,0" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="MÓDULOS DEL MOSTRADOR" FontSize="10" FontWeight="ExtraBold" Foreground="#A9BF88" Margin="8,0,0,8" />

                        <!-- 1. Punto de Venta (POS) -->
                        <Button Command="{Binding NavegarPosCommand}" 
                                HorizontalContentAlignment="Left" 
                                Padding="10,10" 
                                Margin="0,0,0,6" 
                                FontSize="13" 
                                FontWeight="Bold"
                                Background="{Binding IsPosActive, Converter={StaticResource ActiveBgConv}}" 
                                Foreground="{Binding IsPosActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsPosActive, Converter={StaticResource ActiveBorderConv}}"
                                BorderThickness="1.5"
                                AutomationProperties.Name="Navegar al Punto de Venta POS"
                                AutomationProperties.HelpText="Abre el módulo de ventas rápidas en mostrador, emisión de tickets y facturación"
                                ToolTip="Punto de Venta (POS) - Emitir tickets, buscar productos y procesar cobros">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🛒" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" 
                                           Foreground="{Binding IsPosActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Punto de Venta (POS)" VerticalAlignment="Center" FontWeight="Bold" 
                                           Foreground="{Binding IsPosActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <!-- Indicador Activo Pill -->
                                <Border Grid.Column="2" Width="5" Height="16" Background="#A4C868" CornerRadius="2.5" 
                                        Visibility="{Binding IsPosActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <!-- 2. Inventario Inteligente (Dashboard) -->
                        <Button Command="{Binding NavegarDashboardCommand}" 
                                HorizontalContentAlignment="Left" 
                                Padding="10,10" 
                                Margin="0,0,0,6" 
                                FontSize="13" 
                                FontWeight="Bold"
                                Background="{Binding IsDashboardActive, Converter={StaticResource ActiveBgConv}}" 
                                Foreground="{Binding IsDashboardActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsDashboardActive, Converter={StaticResource ActiveBorderConv}}"
                                BorderThickness="1.5"
                                AutomationProperties.Name="Navegar a Inventario y Almacén"
                                AutomationProperties.HelpText="Muestra el stock actual, alertas de stock mínimo y límite de almacenamiento CuMax"
                                ToolTip="Inventario Inteligente - Consulta de stock, reposición y alertas de capacidad CuMax">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📊" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" 
                                           Foreground="{Binding IsDashboardActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Inventario &amp; Almacén" VerticalAlignment="Center" FontWeight="Bold" 
                                           Foreground="{Binding IsDashboardActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="5" Height="16" Background="#A4C868" CornerRadius="2.5" 
                                        Visibility="{Binding IsDashboardActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <!-- 3. Catálogo y Precios (CRUD) -->
                        <Button Command="{Binding NavegarProductCrudCommand}" 
                                HorizontalContentAlignment="Left" 
                                Padding="10,10" 
                                Margin="0,0,0,6" 
                                FontSize="13" 
                                FontWeight="Bold"
                                Background="{Binding IsProductCrudActive, Converter={StaticResource ActiveBgConv}}" 
                                Foreground="{Binding IsProductCrudActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsProductCrudActive, Converter={StaticResource ActiveBorderConv}}"
                                BorderThickness="1.5"
                                AutomationProperties.Name="Navegar al Catálogo de Productos y Precios Masivos"
                                AutomationProperties.HelpText="Permite crear, modificar y ajustar precios masivos por porcentaje"
                                ToolTip="Catálogo &amp; Precios - Alta de productos, modificación y actualización masiva de precios">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🏷️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" 
                                           Foreground="{Binding IsProductCrudActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Catálogo &amp; Precios" VerticalAlignment="Center" FontWeight="Bold" 
                                           Foreground="{Binding IsProductCrudActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="5" Height="16" Background="#A4C868" CornerRadius="2.5" 
                                        Visibility="{Binding IsProductCrudActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <!-- 4. Créditos y Fiados -->
                        <Button Command="{Binding NavegarCreditsCommand}" 
                                HorizontalContentAlignment="Left" 
                                Padding="10,10" 
                                Margin="0,0,0,6" 
                                FontSize="13" 
                                FontWeight="Bold"
                                Background="{Binding IsCreditsActive, Converter={StaticResource ActiveBgConv}}" 
                                Foreground="{Binding IsCreditsActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsCreditsActive, Converter={StaticResource ActiveBorderConv}}"
                                BorderThickness="1.5"
                                AutomationProperties.Name="Navegar a Gestión de Créditos y Fiados"
                                AutomationProperties.HelpText="Módulo restringido para consulta de deudas, abonos a cuenta y registro de fiados"
                                ToolTip="Créditos y Fiados - Registro de abonos, cuentas por cobrar y límites de crédito (Requiere Gerente)">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="💳" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" 
                                           Foreground="{Binding IsCreditsActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Créditos &amp; Fiados" VerticalAlignment="Center" FontWeight="Bold" 
                                           Foreground="{Binding IsCreditsActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="5" Height="16" Background="#A4C868" CornerRadius="2.5" 
                                        Visibility="{Binding IsCreditsActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <!-- 5. Proformas / Cotizaciones -->
                        <Button Command="{Binding NavegarProformasCommand}" 
                                HorizontalContentAlignment="Left" 
                                Padding="10,10" 
                                Margin="0,0,0,6" 
                                FontSize="13" 
                                FontWeight="Bold"
                                Background="{Binding IsProformasActive, Converter={StaticResource ActiveBgConv}}" 
                                Foreground="{Binding IsProformasActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsProformasActive, Converter={StaticResource ActiveBorderConv}}"
                                BorderThickness="1.5"
                                AutomationProperties.Name="Navegar a Proformas y Cotizaciones"
                                AutomationProperties.HelpText="Emisión de cotizaciones a clientes y conversión posterior a venta POS"
                                ToolTip="Proformas / Cotizaciones - Crear presupuestos e importarlos directamente al Punto de Venta">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📋" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" 
                                           Foreground="{Binding IsProformasActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Proformas / Cotizaciones" VerticalAlignment="Center" FontWeight="Bold" 
                                           Foreground="{Binding IsProformasActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="5" Height="16" Background="#A4C868" CornerRadius="2.5" 
                                        Visibility="{Binding IsProformasActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>

                        <!-- 6. Arqueo de Caja Diario -->
                        <Button Command="{Binding NavegarCashRegisterCommand}" 
                                HorizontalContentAlignment="Left" 
                                Padding="10,10" 
                                Margin="0,0,0,6" 
                                FontSize="13" 
                                FontWeight="Bold"
                                Background="{Binding IsCashRegisterActive, Converter={StaticResource ActiveBgConv}}" 
                                Foreground="{Binding IsCashRegisterActive, Converter={StaticResource ActiveFgConv}}"
                                BorderBrush="{Binding IsCashRegisterActive, Converter={StaticResource ActiveBorderConv}}"
                                BorderThickness="1.5"
                                AutomationProperties.Name="Navegar a Arqueo de Caja Diario"
                                AutomationProperties.HelpText="Cierre diario de caja, balance de efectivo y desglose de movimientos del turno"
                                ToolTip="Arqueo de Caja Diario - Cuadre de caja, ventas en efectivo vs fiado y reporte de turno">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="💵" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" 
                                           Foreground="{Binding IsCashRegisterActive, Converter={StaticResource ActiveIconFgConv}}" />
                                <TextBlock Grid.Column="1" Text="Arqueo de Caja Diario" VerticalAlignment="Center" FontWeight="Bold" 
                                           Foreground="{Binding IsCashRegisterActive, Converter={StaticResource ActiveFgConv}}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Width="5" Height="16" Background="#A4C868" CornerRadius="2.5" 
                                        Visibility="{Binding IsCashRegisterActive, Converter={x:Static views:Converters.BooleanToVisibility}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. PANEL DE AUTORIZACIÓN GERENCIAL Y CAMBIO DE ROL -->
                <Border Grid.Row="3" Background="#151C0C" Padding="12,10" Margin="10,0,10,10" CornerRadius="10"
                        BorderBrush="#354318" BorderThickness="1"
                        AutomationProperties.Name="Panel de usuario y control de rol de seguridad">
                    <StackPanel>
                        <TextBlock Text="AUTORIZACIÓN &amp; SEGURIDAD" FontSize="9" FontWeight="ExtraBold" Foreground="#A9BF88" Margin="0,0,0,6" />
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#2E3B15" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center" BorderBrush="#8FA668" BorderThickness="1">
                                <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NombreUsuarioActual}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" 
                                           TextTrimming="CharacterEllipsis" MaxWidth="165" />
                                <TextBlock Text="{Binding RolActual, StringFormat={}Rol Activo: {0}}" FontSize="10" Foreground="#D4DFCA" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Botón accesibles para autenticarse como Gerente o cambiar de rol -->
                        <Button Command="{Binding AlternarModoAdminCommand}" 
                                Padding="8,6" 
                                FontSize="11" 
                                FontWeight="Bold" 
                                Background="#4A5D23" 
                                Foreground="#FFFFFF" 
                                BorderThickness="1" 
                                BorderBrush="#A4C868" 
                                AutomationProperties.Name="Boton para cambiar rol o autenticar acceso de Gerente"
                                AutomationProperties.HelpText="Abre ventana para ingresar clave de Gerente ('acemar') o cerrar sesión de Administrador"
                                ToolTip="Presione para autenticarse como Gerente (Clave: acemar) o volver al modo Vendedor">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🔐 " FontSize="12" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                <TextBlock Text="Acceso / Cambio de Rol" VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="Clave Administrador: 'acemar'" FontSize="9" Foreground="#A9BF88" Margin="0,4,0,0" TextAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ÁREA PRINCIPAL DERECHA - ENTORNO DE TRABAJO Y BARRA SUPERIOR   -->
        <!-- ============================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Barra Superior con Título y Estado -->
                <RowDefinition Height="60" />
                <!-- ContentControl con Vista Activa en Card Container Adaptable -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR DE LA APLICACIÓN -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DCDEC8" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Título dinámico de la Vista Actual -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TituloVistaActual}" FontSize="20" FontWeight="Black" Foreground="#1E2514" 
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.Name="{Binding TituloVistaActual, StringFormat={}Módulo actual: {0}}" />
                    </StackPanel>

                    <!-- Badge de Rol Activo y Estación de Trabajo -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Badge de Rol Activo con Alto Contraste -->
                        <Border CornerRadius="14" Padding="12,6" Margin="0,0,10,0"
                                Background="#EAF0E1" BorderBrush="#B5C6A0" BorderThickness="1"
                                AutomationProperties.Name="{Binding RolActual, StringFormat={}Rol actual en la estación: {0}}"
                                ToolTip="Rol asignado al usuario activo en este turno">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Rol: " FontSize="12" Foreground="#445037" FontWeight="Medium" />
                                <TextBlock Text="{Binding RolActual}" FontWeight="ExtraBold" FontSize="12" Foreground="#2A3814" />
                            </StackPanel>
                        </Border>

                        <!-- Badge de Terminal de Mostrador -->
                        <Border Background="#F4F6F0" CornerRadius="8" Padding="10,6" BorderBrush="#DCDEC8" BorderThickness="1"
                                ToolTip="Identificador de la estación de trabajo y caja registradora local">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🖥️ Mostrador 01" FontSize="12" FontWeight="Bold" Foreground="#4A5D23" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================== -->
            <!-- CARD CONTAINER RESPONSIVO PARA VISTAS (BOUNDED DESKTOP VIEW)   -->
            <!-- ============================================================== -->
            <Grid Grid.Row="1" Margin="12">
                <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#DCDEC8" BorderThickness="1" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#1E2514" Opacity="0.05" />
                    </Border.Effect>

                    <ContentControl Content="{Binding CurrentViewModel}" Background="Transparent" Focusable="True"
                                    AutomationProperties.Name="Contenido principal del módulo seleccionado" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
