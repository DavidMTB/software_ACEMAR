<Window x:Class="software_ACEMAR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:software_ACEMAR"
        xmlns:vm="clr-namespace:software_ACEMAR.ViewModels"
        xmlns:views="clr-namespace:software_ACEMAR.Views"
        mc:Ignorable="d"
        Title="Ferretería ACEMAR - Sistema de Control y Punto de Venta" 
        Height="820" Width="1300"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Menú Lateral Oscuro (Verde Militar) -->
            <ColumnDefinition Width="270" />
            <!-- Contenedor Principal de Vistas -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!-- MENÚ LATERAL IZQUIERDO (VERDE MILITAR #4A5D23) -->
        <!-- ============================================== -->
        <Border Grid.Column="0" Background="#354318">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Cabecera de la Marca ACEMAR -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!-- Botones de Navegación -->
                    <RowDefinition Height="*" />
                    <!-- Selector de Usuario / Rol (Regla CRE-01) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- LOGO Y TÍTULO ACEMAR -->
                <Border Grid.Row="0" Background="#283312" Padding="20,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#4A5D23" Width="44" Height="44" CornerRadius="8">
                                <TextBlock Text="🛠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="ACEMAR" FontSize="22" FontWeight="ExtraBold" Foreground="#FFFFFF" />
                                <TextBlock Text="FERRETERÍA &amp; ALMACÉN" FontSize="11" FontWeight="Bold" Foreground="#A9BF88" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Indicador de Base de Datos Local -->
                        <Border Background="#1C240C" CornerRadius="6" Padding="10,6" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="BD Local SQLite Activa" FontSize="11" FontWeight="SemiBold" Foreground="#D4DFCA" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Separator Grid.Row="1" Background="#4A5D23" Height="1" Margin="0" />

                <!-- BOTONES DE NAVEGACIÓN -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="10,14,10,0">
                    <StackPanel>
                        <TextBlock Text="MÓDULOS DE MOSTRADOR" FontSize="11" FontWeight="Bold" Foreground="#889876" Margin="10,0,0,8" />

                        <!-- 1. Punto de Venta (POS) -->
                        <Button Command="{Binding NavegarPosCommand}" 
                                HorizontalContentAlignment="Left" 
                                Padding="14,11" 
                                Margin="0,0,0,6" 
                                FontSize="14" 
                                FontWeight="Bold" 
                                Background="#4A5D23" 
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛒 " FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Punto de Venta (POS)" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- 2. Inventario Inteligente (Dashboard) -->
                        <Button Command="{Binding NavegarDashboardCommand}" 
                                HorizontalContentAlignment="Left" 
                                Padding="14,11" 
                                Margin="0,0,0,6" 
                                FontSize="14" 
                                FontWeight="Bold" 
                                Background="#3D4D1C" 
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊 " FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Inventario y Almacén" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- 3. Catálogo y Precios Masivos (CRUD) -->
                        <Button Command="{Binding NavegarProductCrudCommand}" 
                                HorizontalContentAlignment="Left" 
                                Padding="14,11" 
                                Margin="0,0,0,6" 
                                FontSize="14" 
                                FontWeight="Bold" 
                                Background="#3D4D1C" 
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏷️ " FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Catálogo &amp; Precios" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- 4. Créditos y Fiados -->
                        <Button Command="{Binding NavegarCreditsCommand}" 
                                HorizontalContentAlignment="Left" 
                                Padding="14,11" 
                                Margin="0,0,0,6" 
                                FontSize="14" 
                                FontWeight="Bold" 
                                Background="#3D4D1C" 
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💳 " FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Créditos y Fiados" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- 5. Proformas y Cotizaciones -->
                        <Button Command="{Binding NavegarProformasCommand}" 
                                HorizontalContentAlignment="Left" 
                                Padding="14,11" 
                                Margin="0,0,0,6" 
                                FontSize="14" 
                                FontWeight="Bold" 
                                Background="#3D4D1C" 
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋 " FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Proformas / Cotizaciones" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- 6. Arqueo de Caja Diario -->
                        <Button Command="{Binding NavegarCashRegisterCommand}" 
                                HorizontalContentAlignment="Left" 
                                Padding="14,11" 
                                Margin="0,0,0,6" 
                                FontSize="14" 
                                FontWeight="Bold" 
                                Background="#3D4D1C" 
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💵 " FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="Arqueo de Caja Diario" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- PANEL DE USUARIO Y PRUEBA DE ROLES CON LOGIN GERENTE -->
                <Border Grid.Row="3" Background="#283312" Padding="14" Margin="10,0,10,12" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="AUTORIZACIÓN GERENCIAL" FontSize="11" FontWeight="Bold" Foreground="#889876" Margin="0,0,0,6" />
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="👤 " FontSize="16" VerticalAlignment="Center" />
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="{Binding NombreUsuarioActual}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding RolActual, StringFormat={}Rol: {0}}" FontSize="11" Foreground="#C5D1BC" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Botón para alternar rol o autenticarse como Gerente -->
                        <Button Command="{Binding AlternarModoAdminCommand}" 
                                Padding="10,8" 
                                FontSize="12" 
                                FontWeight="Bold" 
                                Background="#4A5D23" 
                                Foreground="#FFFFFF" 
                                BorderThickness="1" 
                                BorderBrush="#61792F" 
                                Cursor="Hand">
                            <TextBlock Text="🔐 Acceso / Cambio de Rol" />
                        </Button>

                        <TextBlock Text="* Gerente: pass 'acemar'" FontSize="10" Foreground="#889876" Margin="0,4,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- ÁREA PRINCIPAL DERECHA                         -->
        <!-- ============================================== -->
        <Grid Grid.Column="1" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <!-- Barra Superior con Título y Estado -->
                <RowDefinition Height="64" />
                <!-- ContentControl con Vista Activa (MVVM) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR DE LA APLICACIÓN -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DCE3D6" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Título de la Vista Actual -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TituloVistaActual}" FontSize="22" FontWeight="Bold" Foreground="#1E2514" />
                    </StackPanel>

                    <!-- Información de Operación y Badge de Rol -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Badge de Rol Activo -->
                        <Border CornerRadius="14" Padding="12,6" Margin="0,0,16,0"
                                Background="#E8EEDF" BorderBrush="#C5D1BC" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Rol Activo: " FontSize="12" Foreground="#556049" />
                                <TextBlock Text="{Binding RolActual}" FontWeight="Bold" FontSize="12" Foreground="#354318" />
                            </StackPanel>
                        </Border>

                        <Border Background="#F4F7EF" CornerRadius="6" Padding="10,6">
                            <TextBlock Text="Mostrador 01" FontSize="12" FontWeight="SemiBold" Foreground="#4A5D23" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- CONTENTCONTROL PARA CAMBIAR VISTAS (MVVM)       -->
            <!-- ============================================== -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Background="#FFFFFF" />
        </Grid>
    </Grid>
</Window>
